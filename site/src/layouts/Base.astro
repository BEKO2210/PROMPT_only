---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Cursor from '../components/Cursor.astro';
import LoadingScreen from '../components/LoadingScreen.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  noIndex?: boolean;
}

const {
  title,
  description,
  image = `${import.meta.env.BASE_URL}og-default.svg`,
  canonical,
  noIndex = false,
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const fullCanonical = canonical ?? new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = image.startsWith('http') ? image : `${siteUrl}${image}`;
---

<!doctype html>
<html lang="de" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#070710" />
    <meta name="color-scheme" content="dark" />

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={fullCanonical} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={fullCanonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Belkis Aslani — Software Compliance & Audit" />
    <meta property="og:site_name" content="Belkis Aslani — Software Compliance & Audit" />
    <meta property="og:locale" content="de_DE" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Belkis Aslani — Software Compliance & Audit" />

    <!-- Favicon (SVG, scales beautifully) -->
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />

    <!-- PWA manifest -->
    <link rel="manifest" href={`${import.meta.env.BASE_URL}manifest.webmanifest`} />

    <!-- Preconnect to font CDN (variable fonts) -->
    <link rel="preconnect" href="https://rsms.me" crossorigin />
    <link rel="preconnect" href="https://fonts.bunny.net" crossorigin />

    <!-- Fonts: Inter Variable + Inter Tight + JetBrains Mono via Bunny CDN
         (privacy-friendly, no Google Fonts tracking) -->
    <link rel="stylesheet" href="https://fonts.bunny.net/css?family=inter:400,500,600,700&family=inter-tight:600,700,800&family=jetbrains-mono:400,500&display=swap" />

    <!-- Structured data: ProfessionalService (Google rich-results target)
         + Person + WebSite via @graph for proper de-duplication. -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "ProfessionalService",
          "@id": `${siteUrl}${import.meta.env.BASE_URL}#service`,
          "name": "Belkis Aslani — Software Compliance & Audit",
          "alternateName": "BA Software Compliance & Audit",
          "description": "Senior-Consulting für regulierte Software-Engagements: EU AI Act, DSGVO, DORA, ISO 27001, PCI-DSS, HIPAA. Audit-, Compliance-, Architecture- und Due-Diligence-Reports.",
          "url": siteUrl + import.meta.env.BASE_URL,
          "email": "belkis.aslani@gmail.com",
          "founder": { "@id": `${siteUrl}${import.meta.env.BASE_URL}#person` },
          "areaServed": [
            { "@type": "Country", "name": "Deutschland" },
            { "@type": "Country", "name": "Österreich" },
            { "@type": "Country", "name": "Schweiz" },
            { "@type": "Place",   "name": "European Union" },
          ],
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Vogelsangstraße 32",
            "postalCode": "71691",
            "addressLocality": "Freiberg am Neckar",
            "addressRegion": "Baden-Württemberg",
            "addressCountry": "DE",
          },
          "priceRange": "€€€",
          "knowsAbout": [
            "EU AI Act",
            "DSGVO / GDPR",
            "DORA (Digital Operational Resilience Act)",
            "ISO/IEC 27001:2022",
            "PCI-DSS v4.0.1",
            "HIPAA",
            "OWASP Top 10",
            "OWASP LLM Top 10",
            "Schrems-II TIA",
            "Technical Due Diligence",
            "Software Architecture (C4 Model)",
            "Security Audit",
            "Performance Audit",
            "RAG System Audit",
          ],
        },
        {
          "@type": "Person",
          "@id": `${siteUrl}${import.meta.env.BASE_URL}#person`,
          "name": "Belkis Aslani",
          "jobTitle": "Senior Software Compliance & Audit Consultant",
          "email": "belkis.aslani@gmail.com",
          "worksFor": { "@id": `${siteUrl}${import.meta.env.BASE_URL}#service` },
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Vogelsangstraße 32",
            "postalCode": "71691",
            "addressLocality": "Freiberg am Neckar",
            "addressCountry": "DE",
          },
        },
        {
          "@type": "WebSite",
          "@id": `${siteUrl}${import.meta.env.BASE_URL}#website`,
          "url": siteUrl + import.meta.env.BASE_URL,
          "name": title,
          "description": description,
          "publisher": { "@id": `${siteUrl}${import.meta.env.BASE_URL}#person` },
          "inLanguage": "de-DE",
        },
      ],
    })} />

    <!-- View transitions: smooth, native, browser-level -->
    <ClientRouter />
  </head>

  <body class="overflow-x-hidden">
    <!-- Loading screen — first-visit brand reveal -->
    <LoadingScreen />

    <!-- Custom cursor — shown by JS only on hover-capable + motion-OK -->
    <Cursor />

    <!-- Skip to content for keyboard / screen-reader users -->
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:rounded-md focus:bg-accent-500 focus:text-ink-950 focus:font-semibold"
    >
      Zum Inhalt springen
    </a>

    <!-- Decorative background layers (fixed, non-interactive) -->
    <div class="pointer-events-none fixed inset-0 -z-10" aria-hidden="true">
      <div class="absolute inset-0 bg-grid-faint bg-grid-faint opacity-[0.35]"></div>
      <div class="absolute inset-0 bg-mesh-hero"></div>
    </div>

    <!-- Cursor-following gradient orbs (Apple-tier ambient effect).
         Three layered orbs with staggered lag, JS-driven. Hidden on
         touch + reduced-motion. -->
    <div class="cursor-orbs" aria-hidden="true">
      <div class="cursor-orb cursor-orb-1"></div>
      <div class="cursor-orb cursor-orb-2"></div>
      <div class="cursor-orb cursor-orb-3"></div>
    </div>

    <slot />

    <!-- Premium primitives: reveals + Lenis + cursor + magnetic + split-text.
         Bundled by Astro (not inline). Initialized on first load AND
         re-initialized after ClientRouter navigation. -->
    <script>
      import { initPremium, initReveals } from '../lib/premium';
      initPremium();
      // Re-run reveals after view-transition swap (Lenis + cursor persist)
      document.addEventListener('astro:after-swap', () => initReveals());
    </script>

    <!-- Card spotlight follow-cursor effect (kept inline for first-paint) -->
    <script is:inline>
      (() => {
        if (typeof window === 'undefined') return;
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) return;
        const wire = () => {
          document.querySelectorAll('.card-spotlight').forEach(card => {
            if (card._spotlightWired) return;
            card._spotlightWired = true;
            card.addEventListener('pointermove', e => {
              const rect = card.getBoundingClientRect();
              card.style.setProperty('--mx', `${e.clientX - rect.left}px`);
              card.style.setProperty('--my', `${e.clientY - rect.top}px`);
            });
          });
        };
        wire();
        document.addEventListener('astro:after-swap', wire);
      })();
    </script>
  </body>
</html>
