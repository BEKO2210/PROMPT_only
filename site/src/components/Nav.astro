---
import Logo from './Logo.astro';

interface NavLink { label: string; href: string }

const links: NavLink[] = [
  { label: 'Methodik',   href: '#methodik' },
  { label: 'Services',   href: '#services' },
  { label: 'Samples',    href: '#samples' },
  { label: 'Prozess',    href: '#prozess' },
  { label: 'Preise',     href: '#preise' },
  { label: 'FAQ',        href: '#faq' },
];
---

<header
  id="site-nav"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
  data-state="top"
>
  <!-- Scroll progress bar (sub-pixel-precise via transform) -->
  <div
    class="absolute top-0 left-0 right-0 h-[2px] bg-white/[0.04]"
    aria-hidden="true"
  >
    <div
      id="scroll-progress"
      class="h-full origin-left bg-gradient-to-r from-accent-400 via-accent-300 to-amber-400"
      style="transform: scaleX(0)"
    ></div>
  </div>

  <!-- Glass bar -->
  <div
    id="nav-bar"
    class="mx-auto max-w-page px-6 sm:px-8 lg:px-12 transition-all duration-300"
  >
    <div
      id="nav-inner"
      class="mt-3 flex items-center justify-between gap-6 rounded-2xl border
             border-transparent bg-transparent px-4 py-2.5
             transition-all duration-300"
    >
      <!-- Logo -->
      <Logo size={32} />

      <!-- Desktop links -->
      <nav class="hidden md:flex items-center gap-1" aria-label="Hauptnavigation">
        {links.map(l => (
          <a
            href={l.href}
            class="group relative px-3 py-2 text-sm font-medium text-ink-200
                   hover:text-ink-50 transition-colors no-tap rounded-md
                   focus-visible:ring-accent-300"
          >
            <span class="relative z-10">{l.label}</span>
            <span
              class="pointer-events-none absolute inset-x-2 -bottom-px h-px
                     scale-x-0 origin-left bg-gradient-to-r from-accent-400 to-transparent
                     transition-transform duration-300 ease-out
                     group-hover:scale-x-100"
              aria-hidden="true"
            ></span>
          </a>
        ))}
      </nav>

      <!-- Right CTA -->
      <div class="flex items-center gap-2">
        <a
          href="#kontakt"
          class="hidden sm:inline-flex items-center gap-1.5 rounded-full
                 bg-accent-500 px-4 py-2 text-sm font-semibold text-ink-950
                 transition-all duration-300 hover:bg-accent-400
                 hover:shadow-glow-accent hover:scale-[1.02]
                 active:scale-[0.98] no-tap focus-visible:ring-accent-300"
        >
          Gespräch buchen
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </a>

        <!-- Mobile menu button -->
        <button
          id="nav-toggle"
          type="button"
          class="md:hidden inline-flex h-10 w-10 items-center justify-center
                 rounded-full glass text-ink-100
                 hover:bg-white/10 transition-colors no-tap
                 focus-visible:ring-accent-300"
          aria-label="Menü öffnen"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg id="icon-open" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="4" y1="7" x2="20" y2="7"/>
            <line x1="4" y1="12" x2="20" y2="12"/>
            <line x1="4" y1="17" x2="20" y2="17"/>
          </svg>
          <svg id="icon-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden">
            <line x1="6" y1="6" x2="18" y2="18"/>
            <line x1="6" y1="18" x2="18" y2="6"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile menu -->
    <div
      id="mobile-menu"
      class="md:hidden hidden mt-2 rounded-2xl glass overflow-hidden"
      role="dialog"
      aria-modal="false"
    >
      <nav class="flex flex-col p-2" aria-label="Mobile navigation">
        {links.map(l => (
          <a
            href={l.href}
            class="rounded-xl px-4 py-3 text-base font-medium text-ink-100
                   hover:bg-white/5 transition-colors no-tap"
            data-mobile-link
          >
            {l.label}
          </a>
        ))}
        <a
          href="#kontakt"
          class="mt-2 rounded-xl bg-accent-500 px-4 py-3 text-base font-semibold
                 text-ink-950 text-center no-tap"
          data-mobile-link
        >
          Gespräch buchen
        </a>
      </nav>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    if (typeof window === 'undefined') return;

    const nav = document.getElementById('site-nav');
    const inner = document.getElementById('nav-inner');
    const progress = document.getElementById('scroll-progress');
    const toggle = document.getElementById('nav-toggle');
    const menu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('icon-open');
    const iconClose = document.getElementById('icon-close');

    if (!nav || !inner || !progress) return;

    // ---- Scroll-driven state: progress bar + nav background ----
    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const ratio = docHeight > 0 ? Math.min(scrollTop / docHeight, 1) : 0;
        progress.style.transform = `scaleX(${ratio})`;

        if (scrollTop > 12) {
          nav.dataset.state = 'scrolled';
          inner.classList.add('glass', 'border-white/10');
          inner.classList.remove('border-transparent');
        } else {
          nav.dataset.state = 'top';
          inner.classList.remove('glass', 'border-white/10');
          inner.classList.add('border-transparent');
        }
        ticking = false;
      });
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    // ---- Mobile menu ----
    if (toggle && menu && iconOpen && iconClose) {
      const closeMenu = () => {
        menu.classList.add('hidden');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Menü öffnen');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
      };
      const openMenu = () => {
        menu.classList.remove('hidden');
        toggle.setAttribute('aria-expanded', 'true');
        toggle.setAttribute('aria-label', 'Menü schließen');
        iconOpen.classList.add('hidden');
        iconClose.classList.remove('hidden');
      };
      toggle.addEventListener('click', () => {
        if (menu.classList.contains('hidden')) openMenu(); else closeMenu();
      });
      menu.querySelectorAll('[data-mobile-link]').forEach(el => {
        el.addEventListener('click', closeMenu);
      });
      // Escape closes
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !menu.classList.contains('hidden')) closeMenu();
      });
    }
  })();
</script>
