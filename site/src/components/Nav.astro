---
import Logo from './Logo.astro';

interface NavLink { label: string; href: string }

const baseUrl = import.meta.env.BASE_URL;
const links: NavLink[] = [
  { label: 'Leistungen', href: `${baseUrl}leistungen` },
  { label: 'Methodik',   href: `${baseUrl}methodik` },
  { label: 'Samples',    href: `${baseUrl}samples` },
  { label: 'Über',       href: `${baseUrl}ueber` },
  { label: 'Kontakt',    href: `${baseUrl}kontakt` },
];
---

<header
  id="site-nav"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
  data-state="top"
>
  <!-- Scroll progress bar -->
  <div
    class="absolute top-0 left-0 right-0 h-[2px] bg-white/[0.04]"
    aria-hidden="true"
  >
    <div
      id="scroll-progress"
      class="h-full origin-left bg-gradient-to-r from-accent-400 via-accent-300 to-amber-400"
      style="transform: scaleX(0)"
    ></div>
  </div>

  <div
    id="nav-bar"
    class="mx-auto max-w-page px-6 sm:px-8 lg:px-12 transition-all duration-300"
  >
    <div
      id="nav-inner"
      class="mt-3 flex items-center justify-between gap-6 rounded-2xl border
             border-transparent bg-transparent px-4 py-2.5
             transition-all duration-300"
    >
      <!-- Logo -->
      <Logo size={40} />

      <!-- Desktop links -->
      <nav class="hidden md:flex items-center gap-1" aria-label="Hauptnavigation">
        {links.map(l => (
          <a
            href={l.href}
            class="group relative px-3 py-2 text-sm font-medium text-ink-200
                   hover:text-ink-50 transition-colors no-tap rounded-md
                   focus-visible:ring-accent-300"
          >
            <span class="relative z-10">{l.label}</span>
            <span
              class="pointer-events-none absolute inset-x-2 -bottom-px h-px
                     scale-x-0 origin-left bg-gradient-to-r from-accent-400 to-transparent
                     transition-transform duration-300 ease-out
                     group-hover:scale-x-100"
              aria-hidden="true"
            ></span>
          </a>
        ))}
      </nav>

      <!-- Right CTA -->
      <div class="flex items-center gap-2">
        <a
          href={`${baseUrl}kontakt`}
          data-magnetic
          data-magnetic-strength="0.3"
          class="hidden sm:inline-flex items-center gap-1.5 rounded-full
                 bg-accent-500 px-4 py-2 text-sm font-semibold text-ink-950
                 transition-all duration-300 hover:bg-accent-400
                 hover:shadow-glow-accent hover:scale-[1.02]
                 active:scale-[0.98] no-tap focus-visible:ring-accent-300"
        >
          Gespräch buchen
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </a>

        <button
          id="nav-toggle"
          type="button"
          class="md:hidden inline-flex h-10 w-10 items-center justify-center
                 rounded-full glass text-ink-100
                 hover:bg-white/10 transition-colors no-tap
                 focus-visible:ring-accent-300"
          aria-label="Menü öffnen"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg id="icon-open" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="4" y1="7" x2="20" y2="7"/>
            <line x1="4" y1="12" x2="20" y2="12"/>
            <line x1="4" y1="17" x2="20" y2="17"/>
          </svg>
          <svg id="icon-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden">
            <line x1="6" y1="6" x2="18" y2="18"/>
            <line x1="6" y1="18" x2="18" y2="6"/>
          </svg>
        </button>
      </div>
    </div>

  </div>

  <!-- ========== Mobile drawer — full-screen cinematic overlay ========== -->
  <div
    id="mobile-menu"
    class="mobile-drawer md:hidden fixed inset-0 z-[60]
           bg-ink-950 backdrop-blur-2xl
           opacity-0 pointer-events-none transition-opacity duration-500"
    role="dialog"
    aria-modal="true"
    aria-label="Hauptnavigation"
    style="background-color: #02020a;"
  >
    <!-- Ambient glow + grid -->
    <div class="absolute inset-0 mission-grid opacity-50 pointer-events-none" aria-hidden="true"></div>
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 h-[420px] w-[420px] rounded-full bg-accent-500/12 blur-[140px] pointer-events-none" aria-hidden="true"></div>

    <!-- Close button -->
    <button
      type="button"
      id="mobile-close"
      class="absolute top-5 right-5 z-10 inline-flex h-12 w-12 items-center justify-center
             rounded-full glass border border-white/15 text-ink-100
             active:scale-95 transition-transform no-tap focus-visible:ring-accent-300"
      aria-label="Menü schließen"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="6" y1="6" x2="18" y2="18"/>
        <line x1="6" y1="18" x2="18" y2="6"/>
      </svg>
    </button>

    <!-- Top corner: mission tag -->
    <div class="absolute top-6 left-6 z-10 mobile-drawer-tag opacity-0">
      <span class="mission-tag">
        <span data-mobile-mission>LIVE · DE</span>
      </span>
    </div>

    <!-- Links — big, stacked, cinematic.
         pt-24 clears the mission-tag + close button at top.
         pb-44 reserves space for the absolute-positioned CTA footer,
         preventing the last link ("Kontakt") from being covered.
         Container scrolls if links exceed available height (rare). -->
    <nav class="absolute inset-0 flex flex-col items-start justify-center px-8 gap-1.5 pt-24 pb-44 overflow-y-auto">
      {links.map((l, i) => (
        <a
          href={l.href}
          data-mobile-link
          data-link-index={i}
          class="mobile-drawer-link group relative block py-2.5 text-4xl sm:text-5xl
                 font-display font-bold tracking-tightest text-ink-100
                 opacity-0 -translate-x-4
                 transition-all duration-500 ease-out
                 hover:text-accent-300 no-tap focus-visible:ring-accent-300 rounded-md"
        >
          <span class="font-mono text-[10px] text-accent-400/80 tracking-[0.2em] uppercase block mb-0.5">
            0{i + 1}
          </span>
          {l.label}
          <span
            class="absolute -bottom-1 left-0 w-0 h-0.5 bg-gradient-to-r from-accent-400 to-transparent group-hover:w-2/3 transition-all duration-400"
            aria-hidden="true"
          ></span>
        </a>
      ))}
    </nav>

    <!-- Bottom: primary CTA + email -->
    <div class="absolute bottom-0 inset-x-0 p-6 pb-9 mobile-drawer-foot opacity-0">
      <a
        href={`${baseUrl}kontakt`}
        data-mobile-link
        class="block w-full rounded-2xl bg-accent-500 text-ink-950
               px-6 py-4 font-semibold text-lg text-center
               shadow-glow-accent active:scale-[0.98] transition-transform no-tap btn-magnetic"
      >
        30-Min Erstgespräch buchen →
      </a>
      <a
        href="mailto:belkis.aslani@gmail.com"
        class="block mt-4 text-center text-sm text-ink-400 font-mono
               hover:text-accent-300 transition-colors no-tap"
      >
        belkis.aslani@gmail.com
      </a>
    </div>
  </div>
</header>

<style>
  /* Mobile drawer transitions — body lock + reveal stagger */
  body.mobile-menu-open { overflow: hidden; }

  .mobile-drawer.is-open {
    opacity: 1;
    pointer-events: auto;
  }
  .mobile-drawer.is-open .mobile-drawer-link {
    opacity: 1;
    transform: translateX(0);
  }
  .mobile-drawer.is-open .mobile-drawer-tag,
  .mobile-drawer.is-open .mobile-drawer-foot {
    opacity: 1;
  }

  /* Stagger each link via per-index transition-delay */
  .mobile-drawer.is-open .mobile-drawer-link[data-link-index="0"] { transition-delay: 80ms; }
  .mobile-drawer.is-open .mobile-drawer-link[data-link-index="1"] { transition-delay: 140ms; }
  .mobile-drawer.is-open .mobile-drawer-link[data-link-index="2"] { transition-delay: 200ms; }
  .mobile-drawer.is-open .mobile-drawer-link[data-link-index="3"] { transition-delay: 260ms; }
  .mobile-drawer.is-open .mobile-drawer-link[data-link-index="4"] { transition-delay: 320ms; }
  .mobile-drawer.is-open .mobile-drawer-tag  { transition: opacity 400ms 380ms ease-out; }
  .mobile-drawer.is-open .mobile-drawer-foot { transition: opacity 400ms 440ms ease-out; }

  @media (prefers-reduced-motion: reduce) {
    .mobile-drawer,
    .mobile-drawer-link,
    .mobile-drawer-tag,
    .mobile-drawer-foot { transition: none !important; }
    .mobile-drawer.is-open .mobile-drawer-link { transition-delay: 0ms !important; }
  }
</style>

<script is:inline>
  // Nav script — designed to survive Astro ClientRouter view-transition
  // swaps. The page DOM gets replaced on every navigation, so any
  // listeners attached to specific element refs would be lost. Instead
  // we use event delegation on `document` (and `window`) — those
  // targets persist across swaps, so the handlers stay live.
  (() => {
    if (typeof window === 'undefined') return;
    if (window.__navWired) return;        // idempotent: only wire once
    window.__navWired = true;

    // ---------- Scroll-progress + glass-on-scroll ----------
    // Re-query DOM each frame because elements get replaced on swap.
    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const nav      = document.getElementById('site-nav');
        const inner    = document.getElementById('nav-inner');
        const progress = document.getElementById('scroll-progress');
        if (nav && inner && progress) {
          const scrollTop = window.scrollY;
          const docHeight = document.documentElement.scrollHeight - window.innerHeight;
          const ratio = docHeight > 0 ? Math.min(scrollTop / docHeight, 1) : 0;
          progress.style.transform = 'scaleX(' + ratio + ')';
          if (scrollTop > 12) {
            nav.dataset.state = 'scrolled';
            inner.classList.add('glass', 'border-white/10');
            inner.classList.remove('border-transparent');
          } else {
            nav.dataset.state = 'top';
            inner.classList.remove('glass', 'border-white/10');
            inner.classList.add('border-transparent');
          }
        }
        ticking = false;
      });
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    document.addEventListener('astro:page-load', onScroll); // initial + per-swap
    onScroll();

    // ---------- Mobile drawer ----------
    const updateMissionTag = () => {
      const tag = document.querySelector('[data-mobile-mission]');
      if (!tag) return;
      const d = new Date();
      const hh = String(d.getUTCHours()).padStart(2, '0');
      const mm = String(d.getUTCMinutes()).padStart(2, '0');
      tag.textContent = 'LIVE · DE · ' + hh + ':' + mm + ' UTC';
    };

    const openMenu = () => {
      const menu      = document.getElementById('mobile-menu');
      const toggle    = document.getElementById('nav-toggle');
      const iconOpen  = document.getElementById('icon-open');
      const iconClose = document.getElementById('icon-close');
      if (!menu || !toggle) return;
      menu.classList.add('is-open');
      document.body.classList.add('mobile-menu-open');
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Menü schließen');
      if (iconOpen)  iconOpen.classList.add('hidden');
      if (iconClose) iconClose.classList.remove('hidden');
      updateMissionTag();
      const firstLink = menu.querySelector('[data-mobile-link]');
      if (firstLink && typeof firstLink.focus === 'function') firstLink.focus();
    };

    const closeMenu = () => {
      const menu      = document.getElementById('mobile-menu');
      const toggle    = document.getElementById('nav-toggle');
      const iconOpen  = document.getElementById('icon-open');
      const iconClose = document.getElementById('icon-close');
      if (menu) menu.classList.remove('is-open');
      document.body.classList.remove('mobile-menu-open');
      if (toggle) {
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Menü öffnen');
      }
      if (iconOpen)  iconOpen.classList.remove('hidden');
      if (iconClose) iconClose.classList.add('hidden');
    };

    const isOpen = () => {
      const menu = document.getElementById('mobile-menu');
      return !!menu && menu.classList.contains('is-open');
    };

    // Delegated click handler — finds the hamburger, close button,
    // drawer link, or backdrop regardless of which page's DOM is mounted.
    document.addEventListener('click', (e) => {
      const target = e.target;
      if (!(target instanceof Element)) return;

      // Hamburger toggle button (#nav-toggle) — accept any descendant of it too
      if (target.closest('#nav-toggle')) {
        if (isOpen()) closeMenu(); else openMenu();
        return;
      }
      // Close button inside the drawer
      if (target.closest('#mobile-close')) {
        closeMenu();
        return;
      }
      // Link inside drawer (closes before navigation)
      if (target.closest('[data-mobile-link]')) {
        closeMenu();
        return;
      }
      // Backdrop click — closes if user taps the drawer surface itself
      if (target.id === 'mobile-menu') {
        closeMenu();
      }
    });

    // Esc key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) closeMenu();
    });

    // Close on ClientRouter swap so drawer doesn't leak across pages
    document.addEventListener('astro:before-swap', () => {
      if (isOpen()) closeMenu();
    });
  })();
</script>
