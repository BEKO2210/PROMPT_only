---
// LoadingScreen — first-visit brand reveal.
// Planet logo zooms in from scale 0.4 + blur to settled state, then halo
// pulses, then overlay fades out.
// Only shows on first visit per session (sessionStorage flag).
// Skip-on-click + auto-dismiss after 1.6 s + Esc-key skip.
const baseUrl = import.meta.env.BASE_URL;
---

<div
  id="loading-screen"
  class="fixed inset-0 z-[100] bg-ink-950 flex items-center justify-center pointer-events-auto"
  aria-hidden="true"
  data-loading-screen
>
  <div class="logo-loader relative">
    <!-- Halo behind logo -->
    <div class="logo-loader-halo absolute inset-0 rounded-full blur-3xl"></div>

    <picture>
      <source srcset={`${baseUrl}logo-256.webp`} type="image/webp" />
      <img
        src={`${baseUrl}logo-256.png`}
        alt="Belkis Aslani Logo"
        width="180"
        height="180"
        class="logo-loader-img relative block"
        decoding="async"
        fetchpriority="high"
      />
    </picture>
  </div>

  <!-- Skip hint -->
  <button
    type="button"
    class="absolute bottom-8 right-8 text-xs uppercase tracking-[0.15em] text-ink-400 hover:text-ink-200 transition-colors focus-visible:ring-accent-300"
    data-loading-skip
  >
    Skip
  </button>
</div>

<style>
  .logo-loader {
    width: 180px;
    height: 180px;
  }
  .logo-loader-img {
    width: 180px;
    height: 180px;
    transform: scale(0.4);
    opacity: 0;
    filter: blur(20px);
    animation: logo-enter 1.1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .logo-loader-halo {
    background: radial-gradient(circle, rgba(0,179,240,0.55), transparent 65%);
    transform: scale(0.6);
    opacity: 0;
    animation: halo-enter 1.3s ease-out 0.2s forwards,
               halo-pulse 2s ease-in-out 1.5s infinite;
  }
  @keyframes logo-enter {
    to { transform: scale(1); opacity: 1; filter: blur(0); }
  }
  @keyframes halo-enter {
    to { transform: scale(1.4); opacity: 1; }
  }
  @keyframes halo-pulse {
    0%, 100% { transform: scale(1.4); opacity: 1; }
    50%       { transform: scale(1.55); opacity: 0.6; }
  }
  @media (prefers-reduced-motion: reduce) {
    .logo-loader-img {
      animation: none;
      transform: none;
      opacity: 1;
      filter: none;
    }
    .logo-loader-halo {
      animation: none;
      transform: scale(1.4);
      opacity: 0.8;
    }
  }
  /* Dismiss state */
  #loading-screen.dismissed {
    pointer-events: none;
    transition: opacity 0.55s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
    opacity: 0;
    transform: scale(1.05);
  }
</style>

<script is:inline>
  (() => {
    if (typeof window === 'undefined') return;
    const SS_KEY = 'ba-loading-shown';

    // Astro's ClientRouter does NOT re-execute inline scripts inserted via
    // view-transition swap. So this IIFE runs exactly once per real page
    // load. We install a permanent astro:before-swap handler so the loading
    // screen markup is stripped from EVERY swapped-in page after the first.

    const dismissNow = (screen) => {
      if (!screen || screen.classList.contains('dismissed')) return;
      screen.classList.add('dismissed');
      document.documentElement.style.overflow = '';
      setTimeout(() => screen.remove(), 650);
    };

    const screen = document.getElementById('loading-screen');

    let alreadyShown = false;
    try { alreadyShown = sessionStorage.getItem(SS_KEY) === '1'; } catch {}

    if (screen) {
      if (alreadyShown) {
        screen.remove();
        document.documentElement.style.overflow = '';
      } else {
        try { sessionStorage.setItem(SS_KEY, '1'); } catch {}
        document.documentElement.style.overflow = 'hidden';

        setTimeout(() => dismissNow(screen), 1700);
        screen.addEventListener('click', () => dismissNow(screen));
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') dismissNow(screen);
        }, { once: true });
      }
    }

    // Strip the loading screen from any future page that gets swapped in
    // by Astro's ClientRouter — its inline script will not re-run, so the
    // markup would otherwise sit there opaque and block interaction.
    document.addEventListener('astro:before-swap', (event) => {
      const next = event.newDocument.getElementById('loading-screen');
      if (next) next.remove();
    });
    document.addEventListener('astro:after-swap', () => {
      document.documentElement.style.overflow = '';
    });
  })();
</script>
