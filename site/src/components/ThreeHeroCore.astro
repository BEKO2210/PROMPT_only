---
// ThreeHeroCore — cinematic Three.js audit-core-orb for the hero.
// Mounts a canvas + provides a graceful animated SVG fallback for
// reduced-motion / mobile / no-WebGL clients. Initialisation is
// dynamic-imported on first paint so the three.js bundle stays out
// of the critical path.

interface Props {
  /** Diameter (px) — controls box size, not WebGL render-size */
  size?: number;
  /** Optional aria-label for the visualisation */
  label?: string;
}

const { size = 480, label = 'Audit-Core: kompiliert die Library zu Reports' } = Astro.props;
---

<div
  class="hero-core relative aspect-square mx-auto select-none pointer-events-none"
  style={`max-width: ${size}px`}
  data-hero-core
  aria-label={label}
  role="img"
>
  <!-- WebGL canvas (init via JS, hidden until ready) -->
  <canvas
    data-hero-core-canvas
    class="hero-core-canvas absolute inset-0 w-full h-full opacity-0 transition-opacity duration-700"
    aria-hidden="true"
  ></canvas>

  <!-- SVG fallback — krasser cinematic orb. Multi-layer:
       - 4 pulsing halo rings at staggered offsets (energy aura)
       - Multi-stop core gradient with chrome highlight crescent
       - 5 orbiting elliptical rings at different angles + speeds
       - 12 particle dots orbiting at 3 different radii
       - Inner light pinch (specular spot)
       - Whole orb slowly rotates -->
  <svg
    data-hero-core-fallback
    viewBox="0 0 240 240"
    class="hero-core-fallback absolute inset-0 w-full h-full transition-opacity duration-700"
    aria-hidden="true"
  >
    <defs>
      <!-- Core: deep ocean to electric cyan to bright rim -->
      <radialGradient id="hcCore" cx="42%" cy="38%" r="60%">
        <stop offset="0%"   stop-color="#c9f5ff" stop-opacity="0.95"/>
        <stop offset="22%"  stop-color="#58dfff" stop-opacity="0.95"/>
        <stop offset="55%"  stop-color="#00b3f0" stop-opacity="0.90"/>
        <stop offset="82%"  stop-color="#003d5c" stop-opacity="0.95"/>
        <stop offset="100%" stop-color="#001020" stop-opacity="1"/>
      </radialGradient>

      <!-- Halo: bright ring fading out -->
      <radialGradient id="hcHalo1" cx="50%" cy="50%" r="50%">
        <stop offset="55%" stop-color="#58dfff" stop-opacity="0"/>
        <stop offset="78%" stop-color="#58dfff" stop-opacity="0.55"/>
        <stop offset="100%" stop-color="#58dfff" stop-opacity="0"/>
      </radialGradient>
      <radialGradient id="hcHalo2" cx="50%" cy="50%" r="50%">
        <stop offset="65%" stop-color="#00b3f0" stop-opacity="0"/>
        <stop offset="85%" stop-color="#00b3f0" stop-opacity="0.35"/>
        <stop offset="100%" stop-color="#00b3f0" stop-opacity="0"/>
      </radialGradient>
      <radialGradient id="hcHalo3" cx="50%" cy="50%" r="50%">
        <stop offset="75%" stop-color="#1ccaff" stop-opacity="0"/>
        <stop offset="92%" stop-color="#1ccaff" stop-opacity="0.20"/>
        <stop offset="100%" stop-color="#1ccaff" stop-opacity="0"/>
      </radialGradient>

      <!-- Chrome highlight gradient -->
      <radialGradient id="hcSpec" cx="38%" cy="32%" r="22%">
        <stop offset="0%"  stop-color="#ffffff" stop-opacity="0.85"/>
        <stop offset="40%" stop-color="#ffffff" stop-opacity="0.30"/>
        <stop offset="100%" stop-color="#ffffff" stop-opacity="0"/>
      </radialGradient>

      <filter id="hcBlur">  <feGaussianBlur stdDeviation="3"/></filter>
      <filter id="hcBlurLg"><feGaussianBlur stdDeviation="8"/></filter>
      <filter id="hcGlow">
        <feGaussianBlur stdDeviation="2.5" result="g"/>
        <feMerge><feMergeNode in="g"/><feMergeNode in="SourceGraphic"/></feMerge>
      </filter>
    </defs>

    <!-- Halo layers — pulse staggered for depth -->
    <circle cx="120" cy="120" r="112" fill="url(#hcHalo3)" filter="url(#hcBlurLg)">
      <animate attributeName="r" values="112;118;112" dur="6.5s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.7;1;0.7" dur="6.5s" repeatCount="indefinite"/>
    </circle>
    <circle cx="120" cy="120" r="104" fill="url(#hcHalo2)" filter="url(#hcBlur)">
      <animate attributeName="r" values="104;110;104" dur="5s" begin="-1.5s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.6;1;0.6" dur="5s" begin="-1.5s" repeatCount="indefinite"/>
    </circle>
    <circle cx="120" cy="120" r="96" fill="url(#hcHalo1)" filter="url(#hcBlur)">
      <animate attributeName="r" values="96;100;96" dur="4s" begin="-2.5s" repeatCount="indefinite"/>
    </circle>

    <!-- ===== RINGS — BACK HALVES (drawn before sphere) =====
         Each ring is split into top-arc (back) + bottom-arc (front)
         using SVG arc paths. The wrapper group applies the same slow
         rotation as the front-rings group, so the rings stay in sync
         while passing through the sphere physically (back-arc hidden
         where the sphere overlaps, front-arc on top of the sphere). -->
    <g style="transform-origin: 120px 120px; animation: hc-spin 60s linear infinite;">
      <!-- ring 1: rx=98 ry=22 tilt 15° -->
      <g transform="rotate(15 120 120)">
        <path d="M 22 120 A 98 22 0 0 0 218 120"
              fill="none" stroke="rgba(88,223,255,0.30)" stroke-width="0.7"/>
      </g>
      <!-- ring 2: rx=92 ry=34 tilt -25° -->
      <g transform="rotate(-25 120 120)">
        <path d="M 28 120 A 92 34 0 0 0 212 120"
              fill="none" stroke="rgba(88,223,255,0.20)" stroke-width="0.6"/>
      </g>
      <!-- ring 3: rx=100 ry=14 tilt 75° -->
      <g transform="rotate(75 120 120)">
        <path d="M 20 120 A 100 14 0 0 0 220 120"
              fill="none" stroke="rgba(0,179,240,0.28)" stroke-width="0.55"/>
      </g>
      <!-- ring 4: rx=88 ry=42 tilt 55° -->
      <g transform="rotate(55 120 120)">
        <path d="M 32 120 A 88 42 0 0 0 208 120"
              fill="none" stroke="rgba(28,202,255,0.16)" stroke-width="0.5"/>
      </g>
      <!-- ring 5: rx=96 ry=28 tilt -65° -->
      <g transform="rotate(-65 120 120)">
        <path d="M 24 120 A 96 28 0 0 0 216 120"
              fill="none" stroke="rgba(201,245,255,0.18)" stroke-width="0.4"/>
      </g>
    </g>

    <!-- ===== PARTICLE DOTS — BACK (drawn before sphere) =====
         Dots with cy < 120 are above the equator → visually "behind"
         the sphere when the orb is viewed from front (sphere occludes
         them where it overlaps).
         No filter:url() — Gaussian-blur on rotating groups crushes
         mobile GPU. Brighter colors + extra circle for soft-glow
         instead. -->
    <g style="transform-origin: 120px 120px; animation: hc-spin-rev 22s linear infinite;">
      <!-- back: y < 120 -->
      <circle cx="84"  cy="46"  r="2.2" fill="#c9f5ff" opacity="0.95"/>
      <circle cx="120" cy="30"  r="1.8" fill="#1ccaff" opacity="0.9"/>
    </g>
    <g style="transform-origin: 120px 120px; animation: hc-spin 38s linear infinite;">
      <circle cx="73"  cy="15"  r="2.0" fill="#c9f5ff" opacity="0.95"/>
    </g>

    <!-- ===== SPHERE — between back and front layers ===== -->
    <!-- Core sphere — large enough to dominate, with pulse -->
    <circle cx="120" cy="120" r="74" fill="url(#hcCore)">
      <animate attributeName="r" values="74;76;74" dur="3.5s" repeatCount="indefinite"/>
    </circle>

    <!-- Inner chrome specular highlight (still on sphere top) -->
    <ellipse cx="100" cy="92" rx="34" ry="18" fill="url(#hcSpec)" filter="url(#hcBlur)"/>

    <!-- Hair-thin equator line — sits ON the sphere (front, but covered
         by anything drawn after) -->
    <ellipse cx="120" cy="120" rx="74" ry="9"
             fill="none" stroke="rgba(255,255,255,0.18)" stroke-width="0.6">
      <animate attributeName="ry" values="9;13;9" dur="8s" repeatCount="indefinite"/>
    </ellipse>

    <!-- ===== RINGS — FRONT HALVES (drawn after sphere) =====
         Mirror group of the back-rings. Same rotation, same tilt
         transforms — only the arc direction differs. -->
    <g style="transform-origin: 120px 120px; animation: hc-spin 60s linear infinite;">
      <g transform="rotate(15 120 120)">
        <path d="M 22 120 A 98 22 0 0 1 218 120"
              fill="none" stroke="rgba(88,223,255,0.55)" stroke-width="0.9"/>
      </g>
      <g transform="rotate(-25 120 120)">
        <path d="M 28 120 A 92 34 0 0 1 212 120"
              fill="none" stroke="rgba(88,223,255,0.40)" stroke-width="0.7"/>
      </g>
      <g transform="rotate(75 120 120)">
        <path d="M 20 120 A 100 14 0 0 1 220 120"
              fill="none" stroke="rgba(0,179,240,0.50)" stroke-width="0.65"/>
      </g>
      <g transform="rotate(55 120 120)">
        <path d="M 32 120 A 88 42 0 0 1 208 120"
              fill="none" stroke="rgba(28,202,255,0.32)" stroke-width="0.6"/>
      </g>
      <g transform="rotate(-65 120 120)">
        <path d="M 24 120 A 96 28 0 0 1 216 120"
              fill="none" stroke="rgba(201,245,255,0.35)" stroke-width="0.5"/>
      </g>
    </g>

    <!-- ===== PARTICLE DOTS — FRONT (drawn after sphere) =====
         Dots with cy > 120 are below the equator → visually "in front of"
         the sphere when viewed from front.
         No filter — see back-dots comment above. -->
    <g style="transform-origin: 120px 120px; animation: hc-spin-rev 22s linear infinite;">
      <circle cx="195" cy="120" r="2.2" fill="#c9f5ff" opacity="0.95"/>
      <circle cx="84"  cy="194" r="2.0" fill="#58dfff" opacity="0.95"/>
      <circle cx="45"  cy="120" r="2.0" fill="#58dfff" opacity="0.95"/>
      <circle cx="210" cy="120" r="1.6" fill="#1ccaff" opacity="0.9"/>
      <circle cx="30"  cy="120" r="1.6" fill="#1ccaff" opacity="0.9"/>
      <circle cx="120" cy="210" r="1.8" fill="#1ccaff" opacity="0.9"/>
    </g>
    <g style="transform-origin: 120px 120px; animation: hc-spin 38s linear infinite;">
      <circle cx="225" cy="120" r="2.0" fill="#58dfff" opacity="0.95"/>
      <circle cx="167" cy="225" r="1.6" fill="#00b3f0" opacity="0.9"/>
      <circle cx="15"  cy="120" r="1.8" fill="#00b3f0" opacity="0.9"/>
    </g>

    <!-- (Removed bottom shadow band — was rendering as a horizontal
         dark streak across the viewport on mobile, looking like a
         glitch line rather than a subtle grounding shadow.) -->
  </svg>

  <style>
    @keyframes hc-spin     { to { transform: rotate(360deg);  } }
    @keyframes hc-spin-rev { to { transform: rotate(-360deg); } }
    @media (prefers-reduced-motion: reduce) {
      .hero-core-fallback g[style*="hc-spin"] {
        animation: none !important;
      }
    }
  </style>

  <!-- Floating audit panels — orbit the core (lg+ only; on tablets
       and below the panels overlap the orb + viewport edges) -->
  <div class="hero-core-panels pointer-events-none absolute inset-0 hidden lg:block">
    <div class="float-panel absolute" style="top: 8%;  right: -4%; animation-delay: -1s;">
      <span class="text-danger">●</span> AUD-001 · IDOR detected
    </div>
    <div class="float-panel absolute" style="bottom: 22%; left: -10%; animation-delay: -3s;">
      <span class="text-amber-400">●</span> DSGVO · 47 PII fields mapped
    </div>
    <div class="float-panel absolute" style="bottom: -2%; right: 6%; animation-delay: -5s;">
      <span class="text-success">●</span> 78 workflows · 100% verbatim
    </div>
  </div>
</div>

<script>
  import { mountHeroCore } from '../lib/three-hero';

  type HeroHandle = { destroy: () => void } | null;
  const handles = new WeakMap<HTMLCanvasElement, HeroHandle>();

  const init = async (root: HTMLElement) => {
    const canvas = root.querySelector<HTMLCanvasElement>('[data-hero-core-canvas]');
    const fallback = root.querySelector<HTMLElement>('[data-hero-core-fallback]');
    if (!canvas) return;

    const handle = await mountHeroCore(canvas);
    if (handle) {
      handles.set(canvas, handle);
      canvas.style.opacity = '1';
      if (fallback) fallback.style.opacity = '0';
    }
    // If null, leave fallback visible — no further action
  };

  const wire = () => {
    document.querySelectorAll<HTMLElement>('[data-hero-core]').forEach((el) => {
      if ((el as HTMLElement & { _heroInit?: boolean })._heroInit) return;
      (el as HTMLElement & { _heroInit?: boolean })._heroInit = true;
      // Defer until idle so we don't block first paint
      const start = () => init(el);
      if ('requestIdleCallback' in window) {
        (window as Window & typeof globalThis).requestIdleCallback(start, { timeout: 800 });
      } else {
        setTimeout(start, 250);
      }
    });
  };

  wire();
  document.addEventListener('astro:after-swap', wire);
  document.addEventListener('astro:before-swap', () => {
    document.querySelectorAll<HTMLCanvasElement>('[data-hero-core-canvas]').forEach((c) => {
      handles.get(c)?.destroy();
      handles.delete(c);
    });
  });
</script>
