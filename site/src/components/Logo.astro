---
interface Props {
  size?: number;
  withText?: boolean;
  href?: string;
}
// Default href respects Astro's configured base URL so the link works
// both on root-domain deployments and on /PROMPT_only/ project pages.
const { size = 36, withText = true, href = import.meta.env.BASE_URL } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;

// Pick the right asset size (closest one ≥ display size × DPR=2 for retina)
const target = size <= 32 ? 64 : size <= 64 ? 128 : size <= 128 ? 256 : 512;
---

<a
  href={href}
  class="logo-link group inline-flex items-center gap-3 no-tap focus-visible:ring-accent-300 rounded-md"
  aria-label="Belkis Aslani — Software Compliance & Audit, zur Startseite"
>
  <!-- Logo image: WebP-first with PNG fallback. Wrapped in a <span>
       so the orbit-shimmer effect (CSS pseudo-element) has a container -->
  <span
    class="logo-mark relative inline-flex shrink-0 items-center justify-center"
    style={`width:${size}px;height:${size}px`}
    aria-hidden="true"
  >
    <picture>
      <source srcset={`${baseUrl}logo-${target}.webp`} type="image/webp" />
      <img
        src={`${baseUrl}logo-${target}.png`}
        alt=""
        width={size}
        height={size}
        class="logo-img relative z-10 block transition-transform duration-700 ease-out group-hover:scale-110 group-hover:rotate-[8deg]"
        decoding="async"
        loading="eager"
        fetchpriority="high"
      />
    </picture>
    <!-- Soft glow behind the logo -->
    <span
      class="absolute inset-0 -z-0 rounded-full blur-[14px] opacity-50
             bg-gradient-to-br from-accent-400/50 via-success/30 to-accent-500/50
             transition-opacity duration-500 group-hover:opacity-90"
      aria-hidden="true"
    ></span>
  </span>

  {withText && (
    <span class="flex flex-col leading-none">
      <span class="font-display font-semibold text-ink-100 tracking-tight text-base">
        Belkis Aslani
      </span>
      <span class="font-mono text-[10px] text-ink-400 mt-1 tracking-wider uppercase">
        Software Compliance &amp; Audit
      </span>
    </span>
  )}
</a>

<style>
  /* Subtle continuous float — never stop hover-tilting */
  @media (prefers-reduced-motion: no-preference) {
    .logo-img {
      animation: logo-float 5s ease-in-out infinite;
    }
    .logo-link:hover .logo-img {
      animation-play-state: paused;
    }
  }
  @keyframes logo-float {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50%       { transform: translateY(-2px) rotate(-2deg); }
  }
</style>
