---
import Logo from './Logo.astro';
import FrameworkStrip from './FrameworkStrip.astro';

const year = new Date().getFullYear();
const buildDate = new Date().toISOString().slice(0, 10);

const baseUrl = import.meta.env.BASE_URL;
const linkGroups = [
  {
    title: 'Leistungen',
    links: [
      { label: 'Services + Preise', href: `${baseUrl}leistungen` },
      { label: 'Methodik',          href: `${baseUrl}methodik` },
      { label: 'Sample-Reports',    href: `${baseUrl}samples` },
    ],
  },
  {
    title: 'Über',
    links: [
      { label: 'Über Belkis',  href: `${baseUrl}ueber` },
      { label: 'Kontakt',      href: `${baseUrl}kontakt` },
      { label: 'Library auf GitHub', href: 'https://github.com/beko2210/PROMPT_only', external: true },
    ],
  },
  {
    title: 'Rechtliches',
    links: [
      { label: 'Impressum',          href: `${baseUrl}impressum` },
      { label: 'Datenschutz',        href: `${baseUrl}datenschutz` },
      { label: 'Library-Audit',      href: 'https://github.com/beko2210/PROMPT_only/blob/main/LIBRARY-AUDIT.md', external: true },
      { label: 'Disclaimer-Texte',   href: 'https://github.com/beko2210/PROMPT_only/tree/main/_LEGAL', external: true },
    ],
  },
];
---

<footer class="relative border-t border-white/10 mt-section overflow-hidden">
  <!-- Subtle gradient + grid frame -->
  <div class="absolute inset-0 -z-10 pointer-events-none" aria-hidden="true">
    <div class="absolute inset-0 mission-grid opacity-30"></div>
    <div class="absolute -bottom-40 left-1/2 -translate-x-1/2 h-[300px] w-[600px] rounded-full bg-accent-500/5 blur-[120px]"></div>
  </div>

  <!-- Top: framework strip — branded chip rail -->
  <div class="border-b border-white/5 py-6 bg-ink-vacuum/40">
    <FrameworkStrip tone="subtle" />
  </div>

  <div class="container-page py-12 lg:py-16">

    <!-- Top: brand + links -->
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-12">

      <!-- Brand block -->
      <div class="lg:col-span-4">
        <Logo size={36} />
        <p class="mt-4 text-sm text-ink-300 leading-relaxed max-w-sm">
          Senior-Consulting für regulierte Software-Engagements,
          gefahren mit einer 78-Workflow-Bibliothek.
          Audit · Compliance · Architecture · DD.
        </p>

        <!-- Contact -->
        <div class="mt-6 space-y-2">
          <div class="text-xs uppercase tracking-[0.15em] text-ink-400 font-medium mb-2">
            Belkis Aslani — Software Compliance &amp; Audit
          </div>
          <div class="text-sm text-ink-300">
            Vogelsangstraße 32 · 71691 Freiberg am Neckar
          </div>
          <a href="mailto:belkis.aslani@gmail.com" class="block text-sm text-accent-300 hover:text-accent-200 transition-colors">
            belkis.aslani@gmail.com
          </a>
        </div>
      </div>

      <!-- Link groups -->
      {linkGroups.map(g => (
        <nav class="lg:col-span-2" aria-label={g.title}>
          <div class="text-xs uppercase tracking-[0.15em] text-ink-400 font-medium mb-3">
            {g.title}
          </div>
          <ul class="space-y-2">
            {g.links.map(l => (
              <li>
                <a
                  href={l.href}
                  rel={l.external ? 'noopener' : undefined}
                  target={l.external ? '_blank' : undefined}
                  class="text-sm text-ink-200 hover:text-accent-300 transition-colors no-tap inline-flex items-center gap-1"
                >
                  {l.label}
                  {l.external && (
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <line x1="7" y1="17" x2="17" y2="7"/>
                      <polyline points="7 7 17 7 17 17"/>
                    </svg>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <!-- Hairline -->
    <div class="hairline my-10"></div>

    <!-- Mission-status row — gives the foot a "live" feel, mirrors hero -->
    <div class="flex flex-wrap items-center gap-x-6 gap-y-3 mb-6 text-[10px] uppercase tracking-[0.2em] font-mono text-ink-400">
      <span class="mission-tag">
        <span>Build · {buildDate}</span>
      </span>
      <span class="text-ink-600">/</span>
      <span>Stuttgart-Region · DACH · Remote-first</span>
      <span class="text-ink-600">/</span>
      <span class="text-accent-300/80">Open-Source · MIT-äquivalent</span>
    </div>

    <!-- Bottom: legal info -->
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 text-xs text-ink-400">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
        <span>© {year} Belkis Aslani — Software Compliance &amp; Audit · Alle Rechte vorbehalten</span>
        <span class="hidden lg:inline text-ink-600">·</span>
        <span>Kleinunternehmer gem. § 19 UStG — keine Umsatzsteuer-Ausweisung</span>
      </div>
      <div class="flex items-center gap-2">
        <span>Bibliothek + Site Open Source:</span>
        <a
          href="https://github.com/beko2210/PROMPT_only"
          rel="noopener"
          class="inline-flex items-center gap-1 text-accent-300 hover:text-accent-200 transition-colors no-tap"
        >
          beko2210/PROMPT_only
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="7" y1="17" x2="17" y2="7"/>
            <polyline points="7 7 17 7 17 17"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
