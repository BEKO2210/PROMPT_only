---
// ReportPreview — premium audit-report card with holographic-glass
// styling, severity chips, finding row + progress bar. Reusable in
// hero, samples grid, services teaser etc. Pure CSS — no JS required.

interface Severity {
  label: string;          // e.g. "Critical"
  count: number;
  tone: 'danger' | 'warning' | 'accent' | 'success';
}

interface Finding {
  id: string;             // e.g. "AUD-001"
  title: string;
  file: string;
  severity: 'CRITICAL' | 'HIGH' | 'MEDIUM' | 'LOW';
}

interface Props {
  filename?: string;
  reportType?: string;
  client?: string;
  date?: string;
  severities?: Severity[];
  finding?: Finding;
  remediationProgress?: { fixed: number; total: number };
  /** Optional href — if set, card becomes a link */
  href?: string;
  /** Extra wrapper classes */
  class?: string;
}

const {
  filename = 'AUDIT-REPORT.pdf',
  reportType = 'Security & Code-Quality Audit',
  client = 'Pivot Logistics B.V.',
  date = '2026-05-03',
  severities = [
    { label: 'Critical', count: 3,  tone: 'danger'  },
    { label: 'High',     count: 7,  tone: 'warning' },
    { label: 'Medium',   count: 18, tone: 'accent'  },
  ],
  finding = {
    id: 'AUD-001',
    title: 'IDOR on order-history endpoint',
    file: 'services/orders/api/v2.py:142',
    severity: 'CRITICAL' as const,
  },
  remediationProgress = { fixed: 3, total: 61 },
  href,
  class: extraClass = '',
} = Astro.props;

const toneStyles = {
  danger:  'bg-danger/15 border-danger/30 text-danger',
  warning: 'bg-warning/15 border-warning/30 text-warning',
  accent:  'bg-accent-500/15 border-accent-500/30 text-accent-300',
  success: 'bg-success/15 border-success/30 text-success',
} as const;

const sevTone = (sev: Finding['severity']) =>
  sev === 'CRITICAL' ? 'bg-danger/20 text-danger' :
  sev === 'HIGH'     ? 'bg-warning/20 text-warning' :
  sev === 'MEDIUM'   ? 'bg-accent-500/20 text-accent-300' :
                       'bg-ink-700 text-ink-200';

const Wrapper = href ? 'a' : 'div';
const pct = Math.round((remediationProgress.fixed / remediationProgress.total) * 100);
---

<Wrapper
  {...(href ? { href } : {})}
  class={`report-preview holo-card chrome-sweep relative block rounded-2xl p-6 overflow-hidden ${extraClass}`}
  data-tilt
  data-tilt-max="6"
  aria-label={`Beispiel-Report: ${reportType}`}
>
  <!-- Header: window dots + filename -->
  <div class="relative z-10 flex items-center justify-between mb-5">
    <div class="flex gap-1.5" aria-hidden="true">
      <span class="h-2.5 w-2.5 rounded-full bg-ink-600"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-ink-600"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-ink-600"></span>
    </div>
    <span class="font-mono text-[10px] text-ink-400 tracking-wider">{filename}</span>
  </div>

  <div class="relative z-10 space-y-4">
    <!-- Executive header -->
    <div>
      <div class="text-[10px] uppercase tracking-widest text-accent-300/80 mb-1 font-medium">
        Executive Summary
      </div>
      <div class="font-display text-lg text-ink-50 leading-tight">{reportType}</div>
      <div class="text-xs text-ink-300 mt-0.5">{client} · {date}</div>
    </div>

    <div class="hairline"></div>

    <!-- Severity chips -->
    <div class="grid grid-cols-3 gap-2 text-center">
      {severities.map((sev) => (
        <div class={`rounded-md border px-2 py-2 ${toneStyles[sev.tone]}`}>
          <div class="text-lg font-display font-bold tabular-nums">{sev.count}</div>
          <div class="text-[10px] text-ink-300 uppercase tracking-wide">{sev.label}</div>
        </div>
      ))}
    </div>

    <!-- Finding row -->
    <div class="rounded-lg bg-ink-800/60 border border-white/5 p-3">
      <div class="flex items-center gap-2 mb-1">
        <span class="font-mono text-[10px] text-danger">{finding.id}</span>
        <span class={`rounded-full text-[10px] px-2 py-0.5 font-medium ${sevTone(finding.severity)}`}>
          {finding.severity}
        </span>
      </div>
      <div class="text-sm font-medium text-ink-100 leading-tight">{finding.title}</div>
      <div class="text-[10px] text-ink-400 mt-1 font-mono">{finding.file}</div>
    </div>

    <!-- Remediation progress -->
    <div class="space-y-1.5">
      <div class="flex items-center justify-between text-[10px] text-ink-400">
        <span class="uppercase tracking-wider">Remediation roadmap</span>
        <span class="text-success font-mono tabular-nums">
          {remediationProgress.fixed}/{remediationProgress.total} fixed
        </span>
      </div>
      <div class="h-1 rounded-full bg-ink-800 overflow-hidden">
        <div
          class="h-full rounded-full bg-gradient-to-r from-accent-500 to-accent-300 shadow-glow-accent"
          style={`width: ${pct}%`}
        ></div>
      </div>
    </div>
  </div>
</Wrapper>
