---
import Base from '@layouts/Base.astro';
import Nav from '@components/Nav.astro';
import Hero from '@sections/Hero.astro';
import TrustStrip from '@sections/TrustStrip.astro';
---

<Base
  title="PROMPT_only — Senior Consulting in Tagen, nicht Wochen"
  description="78 production-grade Prompts. 10 redaktierte Sample Deliverables. Audit-, Compliance-, Architecture- und DD-Reports auf Beratungsklasse-Niveau in Tagen statt Wochen."
>
  <Nav />

  <main id="main">
    <Hero />
    <TrustStrip />

    <!-- ============================================================
         Phase 2 ships: Nav, Hero, TrustStrip.
         Phase 3 adds: Problem + Approach (methodology visualization).
         Phase 4 adds: Services Grid + Sample Showcase.
         Phase 5 adds: Process Timeline + Pricing Tiers.
         Phase 6 adds: About + FAQ + Final-CTA + Footer.
         Phase 7: animation polish, perf, a11y, SEO, prod build test.
         ============================================================ -->

    <section id="methodik" class="section">
      <div class="container-page">
        <div class="reveal mb-4 inline-flex items-center gap-2 rounded-full glass px-4 py-2 text-xs text-ink-300">
          <span class="h-1.5 w-1.5 rounded-full bg-accent-400 animate-pulse-glow"></span>
          Build status · Phase 2/7 shipped — Foundation + Hero + Trust
        </div>
        <h2 class="reveal text-display-lg font-display mb-4">Hier kommen die Methodik-Bausteine.</h2>
        <p class="reveal text-lg text-ink-300 max-w-prose-tight">
          Phase 3 visualisiert die 78-Prompt-Library als animierten Stack mit Kategorien.
          Phase 4 zeigt die 9 Service-Cards + interaktiven Sample-Viewer.
          Phase 5 die Timeline und Pricing-Tiers. Phase 6 schließt mit FAQ + Footer.
        </p>
      </div>
    </section>
  </main>
</Base>
