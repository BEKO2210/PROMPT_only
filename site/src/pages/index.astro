---
import Base from '@layouts/Base.astro';
import Nav from '@components/Nav.astro';
import Hero from '@sections/Hero.astro';
import TrustStrip from '@sections/TrustStrip.astro';
import Problem from '@sections/Problem.astro';
import Approach from '@sections/Approach.astro';
import Services from '@sections/Services.astro';
import Samples from '@sections/Samples.astro';
import Process from '@sections/Process.astro';
import Pricing from '@sections/Pricing.astro';
---

<Base
  title="PROMPT_only — Senior Consulting in Tagen, nicht Wochen"
  description="78 production-grade Prompts. 10 redaktierte Sample Deliverables. Audit-, Compliance-, Architecture- und DD-Reports auf Beratungsklasse-Niveau in Tagen statt Wochen."
>
  <Nav />

  <main id="main">
    <Hero />
    <TrustStrip />
    <Problem />
    <Approach />
    <Services />
    <Samples />
    <Process />
    <Pricing />

    <!-- ============================================================
         Phase 6 adds: About + FAQ + Final-CTA + Footer
         Phase 7: animation polish, perf, a11y, SEO, prod build test
         ============================================================ -->

    <section id="faq" class="section">
      <div class="container-page">
        <div class="reveal mb-4 inline-flex items-center gap-2 rounded-full glass px-4 py-2 text-xs text-ink-300">
          <span class="h-1.5 w-1.5 rounded-full bg-accent-400 animate-pulse-glow"></span>
          Build status · Phase 5/7 shipped — + Process + Pricing
        </div>
        <h2 class="reveal text-display-lg font-display mb-4">Phase 6 — FAQ + Final-CTA + Footer folgt.</h2>
        <p class="reveal text-lg text-ink-300 max-w-prose-tight">
          Phase 6 schließt die Seite: About-Block mit Library-Stats-Count-up,
          FAQ-Accordion mit 6–8 Buying-Blockers, Final-CTA mit Cal-Embed-Slot,
          Footer mit Legal + Kontakt + Sitemap.
          Phase 7 ist Animations-Polish + Perf + A11y + SEO + Production-Test.
        </p>
      </div>
    </section>
  </main>
</Base>
