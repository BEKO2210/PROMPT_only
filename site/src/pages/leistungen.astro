---
import Base from '@layouts/Base.astro';
import Nav from '@components/Nav.astro';
import Footer from '@components/Footer.astro';
import PageHeader from '@components/PageHeader.astro';
import Services from '@sections/Services.astro';
import Pricing from '@sections/Pricing.astro';
---

<Base
  title="Leistungen & Preise — Belkis Aslani"
  description="Neun packbare Service-Typen aus der 78-Workflow-Library plus drei anker-gepreiste Engagement-Tiers. AI Act, DSGVO, DORA, ISO 27001, PCI-DSS, M&A TDD, Architecture, Performance, RAG-Audit."
>
  <Nav />

  <main id="main">
    <PageHeader
      eyebrow="Leistungen"
      title="Neun Engagement-Typen. Drei Preis-Tiers. Keine versteckten Kosten."
      lede="Jeder Service mapped einen Tier-2-Workflow aus der Bibliothek auf eine verkaufsfertige Beratungs-Leistung. Preise sind Anker-Ranges — sie spiegeln, was Märkte tatsächlich zahlen, nicht Wunschdenken."
    />

    <Services />
    <Pricing />
  </main>

  <Footer />
</Base>
