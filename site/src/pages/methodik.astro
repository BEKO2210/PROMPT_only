---
import Base from '@layouts/Base.astro';
import Nav from '@components/Nav.astro';
import Footer from '@components/Footer.astro';
import PageHeader from '@components/PageHeader.astro';
import Approach from '@sections/Approach.astro';
import Process from '@sections/Process.astro';
---

<Base
  title="Methodik — Belkis Aslani · Software Compliance & Audit"
  description="78 production-grade Workflows in acht Kategorien. Vier-Stage-Prozess von Discovery zu Handover. Library, Vorgehensweise und Qualitäts-Gates der Beratung."
>
  <Nav />

  <main id="main">
    <PageHeader
      eyebrow="Methodik"
      title="Die Bibliothek hinter jedem Engagement."
      lede="Jeder Workflow ist ein production-grade Prompt mit Verifikations-Checkliste, verbatim-Disclaimer, Sample-Output und Pricing-Indikation. Vier Stages vom Discovery-Call bis zur Übergabe."
    />

    <Approach />
    <Process />
  </main>

  <Footer />
</Base>
