---
import Base from '@layouts/Base.astro';
import Nav from '@components/Nav.astro';
import Footer from '@components/Footer.astro';
import PageHeader from '@components/PageHeader.astro';
import Samples from '@sections/Samples.astro';
---

<Base
  title="Sample Deliverables — Belkis Aslani"
  description="Zehn redaktierte Beispiel-Reports aus fiktiven aber strukturell realistischen Engagements: Security Audit, Performance Audit, EU AI Act Conformity, DSGVO Assessment, SBOM, Architecture Dossier, M&A TDD, RAG Audit. Honorare und Befunde am Markt-Niveau."
>
  <Nav />

  <main id="main">
    <PageHeader
      eyebrow="Sample Deliverables"
      title="Sieh was du kaufst, bevor du kaufst."
      lede="Zehn redaktierte Beispiel-Reports aus fiktiven aber strukturell realistischen Engagements. Jedes Sample zeigt die echte Deliverable-Shape — Honorare und Befunde spiegeln, was vergleichbare Engagements am Markt liefern."
    />

    <Samples />
  </main>

  <Footer />
</Base>
