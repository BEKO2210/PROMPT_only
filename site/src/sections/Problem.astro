---
// Problem — acknowledges the buyer's pain in their own language.
// Three specific friction points with concrete cost framing.
// Designed to make the reader nod three times before the methodology
// section explains why this library solves it.

interface Friction {
  /** Icon key — resolved to inline SVG below */
  icon: 'time' | 'drift' | 'opacity';
  title: string;
  body: string;
  costLabel: string;
  cost: string;
  costTone: 'warning' | 'danger';
}

const frictions: Friction[] = [
  {
    icon: 'time',
    title: 'Sechs Wochen bis zum ersten Entwurf',
    body: 'Jedes Engagement startet bei null. Templates passen nicht zum Mandanten. Senior-Berater schreiben Boilerplate statt Befunde.',
    costLabel: 'Versteckte Kosten',
    cost: '€12–30k Beratungsaufwand vor dem ersten echten Finding',
    costTone: 'warning',
  },
  {
    icon: 'drift',
    title: 'Quality drift zwischen Engagements',
    body: 'Jeder Berater hat seine Methode. Findings werden mal mit, mal ohne file:line zitiert. Disclaimer verwässern. Investment Committees merken das.',
    costLabel: 'Risiko',
    cost: 'Haftungs-Exposition bei jeder Inkonsistenz',
    costTone: 'danger',
  },
  {
    icon: 'opacity',
    title: 'Käufer sieht nicht was er kauft',
    body: 'Ohne Sample-Outputs vor Vertragsabschluss vergleicht der Käufer nur Preis. Race-to-the-bottom statt Value-Selling.',
    costLabel: 'Konversion',
    cost: '3–8 % Close-Rate bei Cold Outreach',
    costTone: 'warning',
  },
];

const toneStroke = (t: 'warning' | 'danger') =>
  t === 'danger' ? '#ef4444' : '#f59e0b';
---

<section id="problem" class="section relative">
  <div class="container-page">
    <!-- Eyebrow -->
    <div class="reveal text-[11px] uppercase tracking-[0.2em] text-accent-400 mb-3 font-medium">
      Das Problem
    </div>

    <!-- Headline -->
    <h2 class="reveal text-display-lg font-display tracking-tight max-w-4xl mb-6">
      Beratungs-Engagements scheitern selten an Substanz.
      Sie scheitern an
      <span class="text-gradient">Liefer-Zeit</span>,
      <span class="text-gradient">Verifizierbarkeit</span>
      und
      <span class="text-gradient">Wiederholbarkeit</span>.
    </h2>

    <p class="reveal max-w-prose-tight text-lg text-ink-300 leading-snug mb-16">
      Die meisten Probleme im Beratungs-Geschäft sind nicht intellektuell.
      Sie sind operativ. Drei Reibungspunkte machen 80 % der Marge kaputt:
    </p>

    <!-- 3 friction cards -->
    <div class="grid md:grid-cols-3 gap-6">
      {frictions.map((f, i) => (
        <article
          class="reveal card-spotlight glass rounded-2xl p-6 lg:p-8 relative overflow-hidden"
          style={`animation-delay: ${i * 80}ms`}
        >
          <!-- Numbered badge -->
          <div class="absolute top-4 right-4 text-[10px] font-mono text-ink-500 tabular-nums">
            0{i + 1}
          </div>

          <!-- Premium SVG icon — accent-tinted, sits in a soft halo square -->
          <div
            class="relative mb-5 inline-flex h-14 w-14 items-center justify-center
                   rounded-2xl border bg-ink-900/60 backdrop-blur"
            style={`border-color: ${toneStroke(f.costTone)}40;
                    box-shadow: 0 0 24px ${toneStroke(f.costTone)}25, inset 0 1px 0 rgba(255,255,255,0.06);`}
            aria-hidden="true"
          >
            {f.icon === 'time' && (
              <svg width="28" height="28" viewBox="0 0 32 32" fill="none" stroke={toneStroke(f.costTone)} stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="16" cy="16" r="11.5" stroke-opacity="0.35"/>
                <path d="M16 8.5v7.5l5 3" stroke-width="1.8"/>
                <circle cx="16" cy="16" r="1.6" fill={toneStroke(f.costTone)} stroke="none"/>
                <path d="M5 16h2M25 16h2M16 5v2M16 25v2" stroke-opacity="0.55"/>
              </svg>
            )}
            {f.icon === 'drift' && (
              <svg width="28" height="28" viewBox="0 0 32 32" fill="none" stroke={toneStroke(f.costTone)} stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="16" cy="16" r="11" stroke-opacity="0.35"/>
                <circle cx="16" cy="16" r="7"  stroke-opacity="0.55"/>
                <circle cx="16" cy="16" r="3"  stroke-opacity="0.85"/>
                <!-- Off-center hit marks - drift away from bullseye -->
                <circle cx="12" cy="9"  r="0.9" fill={toneStroke(f.costTone)} stroke="none"/>
                <circle cx="22" cy="13" r="0.9" fill={toneStroke(f.costTone)} stroke="none"/>
                <circle cx="20" cy="22" r="0.9" fill={toneStroke(f.costTone)} stroke="none"/>
              </svg>
            )}
            {f.icon === 'opacity' && (
              <svg width="28" height="28" viewBox="0 0 32 32" fill="none" stroke={toneStroke(f.costTone)} stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <!-- Frame / document outline -->
                <rect x="6" y="5" width="20" height="22" rx="2" stroke-opacity="0.4"/>
                <!-- Obscured content lines -->
                <line x1="9" y1="10" x2="20" y2="10" stroke-opacity="0.25" stroke-dasharray="2 2"/>
                <line x1="9" y1="14" x2="23" y2="14" stroke-opacity="0.25" stroke-dasharray="2 2"/>
                <line x1="9" y1="18" x2="18" y2="18" stroke-opacity="0.25" stroke-dasharray="2 2"/>
                <line x1="9" y1="22" x2="21" y2="22" stroke-opacity="0.25" stroke-dasharray="2 2"/>
                <!-- Lock overlay (hides the content) -->
                <rect x="13" y="13" width="10" height="8" rx="1.6" fill="rgba(11,11,22,0.85)"/>
                <rect x="13" y="13" width="10" height="8" rx="1.6" stroke-width="1.6"/>
                <path d="M15.5 13v-1.5a2.5 2.5 0 015 0V13" stroke-width="1.6"/>
                <circle cx="18" cy="17" r="0.9" fill={toneStroke(f.costTone)} stroke="none"/>
              </svg>
            )}
          </div>

          <h3 class="font-display text-xl text-ink-50 mb-3 leading-tight">
            {f.title}
          </h3>

          <p class="text-ink-300 text-base leading-snug mb-6">
            {f.body}
          </p>

          <div class="mt-auto pt-4 border-t border-white/5">
            <div class="text-[10px] uppercase tracking-[0.15em] text-ink-400 mb-1.5 font-medium">
              {f.costLabel}
            </div>
            <div class:list={[
              'text-base font-display leading-snug font-medium',
              f.costTone === 'danger' ? 'text-danger' : 'text-warning'
            ]}>
              {f.cost}
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Closing line that transitions to the next section -->
    <div class="reveal mt-16 text-center">
      <p class="text-lg text-ink-300 max-w-2xl mx-auto">
        Die Lösung ist keine bessere Beratungs-Software.
        Es ist <span class="text-ink-100 font-medium">strukturierte Wiederholbarkeit</span>.
      </p>
      <a href="/PROMPT_only/methodik" class="btn-ghost mt-4 inline-flex items-center gap-2 no-tap">
        So sieht das aus
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="5" x2="12" y2="19"/>
          <polyline points="19 12 12 19 5 12"/>
        </svg>
      </a>
    </div>
  </div>
</section>
