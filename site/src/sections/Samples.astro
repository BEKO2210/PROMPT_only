---
// Samples — interactive showcase of the 10 redacted sample
// deliverables. THE proof element: 'show, don't tell'. The audit
// flagged this as the single highest-impact gap; this section
// closes it for the buyer-facing surface.
//
// Layout:
//   Desktop  — vertical tab list left, full document preview right
//   Mobile   — accordion: tap tab to expand below
// State managed via simple buttons + data attributes; no framework.

interface Sample {
  id: string;          // matches sampleAnchor in Services.astro
  prompt: string;      // SHIP / HUNT / AUDIT / etc.
  category: 'Internal' | 'Strategic' | 'Compliance' | 'AI';
  title: string;       // headline (German)
  client: string;      // fictional client + sector
  fee: string;         // engagement fee for the sample
  date: string;        // assessment date
  highlights: string[];// 3-4 bullet findings
  excerpt: string;     // 2-3 sentence intro from the actual sample
  outcomeNumber?: string; // headline metric
  outcomeLabel?: string;
}

const samples: Sample[] = [
  {
    id: 'sample-ship', prompt: 'SHIP', category: 'Internal',
    title: '8-Section-Workflow auf einen EU-Password-Reset-Delay-Bug',
    client: 'fiktive SaaS-Anwendung',
    fee: 'Internal workflow',
    date: '2026-05',
    highlights: [
      '§3 ROOT CAUSE: Single-Region-Worker-Pool gesättigt während EU-Peak',
      '§4 PLAN: 4 Files, regional queue + EU-Worker-Deploy',
      '§7 ACCEPTANCE: synthetic test p95 < 90s nach Deploy',
      '§8 VERIFICATION: production p95 47s gemessen nach 24h',
    ],
    excerpt: 'EU-Nutzer sahen 4–6 Stunden Verzögerung auf Password-Reset-Mails. Statische Code-Analyse identifizierte das Single-Region-Worker-Setup als Engpass; der Fix war eine regionale Queue-Topologie statt mehr Worker.',
  },
  {
    id: 'sample-hunt', prompt: 'HUNT', category: 'Internal',
    title: 'Race Condition zwischen Promo-Apply und Email-Render',
    client: 'fiktive E-Commerce-Plattform',
    fee: 'Internal workflow',
    date: '2026-05',
    highlights: [
      '§2 REPRO: tests/integration test_promo_race nach Bisect identifiziert PR #1812',
      '§5 PROBE: instrumentation bestätigte 9/10 Runs zeigen pending_promo_recalc beim Email-Render',
      '§6 FIX: 5-Zeilen-Change in get_lineitems_for_email',
      '§8 REGRESSION: 100/100 Runs grün post-fix, plus stricter regression test',
    ],
    excerpt: '47 CS-Tickets in 6 Wochen über Email-Bestätigungen mit quantity=0 trotz korrekter DB-Werte. git bisect lokalisierte den verantwortlichen PR; PROBE bestätigte Race Condition zwischen async Promo-Recalc und Email-Render.',
  },
  {
    id: 'sample-audit', prompt: 'AUDIT', category: 'Strategic',
    title: 'Security & Code-Quality Audit für B2B-Logistik-SaaS',
    client: 'Pivot Logistics B.V. (fiktiv) · 400 Merchants · 12M PII Records',
    fee: '€5 800 engagement · 4 Tage Critical-Fix-Turnaround',
    date: '2026-05-03',
    outcomeNumber: '61', outcomeLabel: 'Findings (3 Crit / 7 High)',
    highlights: [
      'AUD-001 IDOR: any merchant kann all merchants order-history lesen',
      'AUD-002 SQL Injection in 4 Analytics-Endpoints',
      'AUD-003 AWS keys in commit history (rotation required)',
      '14 dependency CVEs gemappt mit clear upgrade-paths',
    ],
    excerpt: 'OWASP-Top-10-Review identifizierte 3 Critical / 7 High / 18 Medium / 22 Low / 11 Info Findings. IDOR auf /api/v2/orders/{merchant_id} ist ein Single-Line-Auth-Check-Fix mit DSGVO-Notifikations-Risiko bei Exploit.',
  },
  {
    id: 'sample-perf', prompt: 'PERF', category: 'Strategic',
    title: 'Performance Audit für DTC-E-Commerce Checkout',
    client: 'Vellum Commerce GmbH (fiktiv) · €18M GMV/Jahr',
    fee: '€7 200 engagement · ~€250k/Jahr Revenue-Impact projiziert',
    date: '2026-05-09',
    outcomeNumber: '77 %', outcomeLabel: 'p95 Latenz-Reduktion',
    highlights: [
      'Cart-Summary N+1 in services/cart/summary.ts:78 — 3-3.8× Speedup, 1d Effort',
      'Product-Detail Redis-Cache fehlt — 1.8-2.4× Speedup, 2d Effort',
      'Sync Shipping-Rate-Call blockt Checkout — 1.6-2× Speedup, 3d Effort',
      'Projiziert: p95 1850ms → 420ms, 1% conversion pro 100ms = ~€250k/Jahr',
    ],
    excerpt: 'Gemessen via k6 + pprof + pg_stat_statements: Top-3-Hotspots tragen 83% der Checkout-Latenz. Frontend-CWV gesund, Backend-Application-Layer dominiert. Top-3-Fixes ROI-priorisiert mit konkretem Effort + Risk.',
  },
  {
    id: 'sample-arch', prompt: 'ARCH', category: 'Strategic',
    title: 'Architecture Dossier für EU-Neobank',
    client: 'Banque Atlantique S.A. (fiktiv) · 250k retail customers',
    fee: '€11 000 engagement · passed ISO 27001 §A.8.27 evidence audit',
    date: '2026-05-11',
    outcomeNumber: '4', outcomeLabel: 'C4-Levels in Mermaid · 10 ADRs',
    highlights: [
      'System Context · Container · Component · Code in Mermaid (versionierbar)',
      '10 ADRs in Nygard-Format mit cited code evidence',
      'SEPA-Transfer-Sequence mit file:line Entry Points',
      '5 Architektur-Risiken inkl. Bus-Factor auf Auth-Service',
    ],
    excerpt: 'Vollständiges C4-Dossier mit Container-/Component-Diagrammen, ADRs für CockroachDB-Ledger und synchroner Sanctions-Screening-Entscheidung, plus Risk Register. Diagramme rendern nativ in GitHub und Confluence; passed ISO 27001 §A.8.27 audit ohne substantive Kommentare.',
  },
  {
    id: 'sample-dd', prompt: 'DD', category: 'Strategic',
    title: 'Technical Due Diligence für €120M Series-B Acquisition',
    client: 'Helios Capital (fiktive PE) · Target: Verdant Health (Clinical-Trial-SaaS)',
    fee: '€38 000 engagement',
    date: '2026-05-12',
    outcomeNumber: '🔴 1 / 🟡 4 / 🟢 4', outcomeLabel: 'R/A/G section ratings',
    highlights: [
      '🔴 Bus-Factor: 67% of code by single CTO; retention escrow required',
      '🟡 GPL-3.0 contamination in 2 components; license cleanup pre-close',
      '🟡 HIPAA BAA gaps: 4 vendors processing PHI without verified BAA',
      'Verdict: ACCEPTABLE WITH CAVEATS — proceed at adjusted terms',
    ],
    excerpt: 'Investment Committee briefing für €120M acquisition. R/A/G-Dashboard auf Seite 2, evidenzgestützte Findings mit code-citations für jede 🔴 RED rating. Empfohlene Deal-Conditions: 20% retention escrow auf CTO consideration, R&W focus auf OSS-License + BAA-Execution, post-close investment €1.5–2.5M für cleanup.',
  },
  {
    id: 'sample-gdpr', prompt: 'GDPR', category: 'Compliance',
    title: 'DSGVO-Assessment + Art. 30 RoPA für EU B2B SaaS',
    client: 'Cumulus Customer Insights GmbH (fiktiv, DE)',
    fee: '€6 500 engagement',
    date: '2026-05-08',
    outcomeNumber: '5', outcomeLabel: 'kritische Gaps · 3 RED Schrems-II Transfers',
    highlights: [
      'OpenAI Transfer: 🔴 VISIBLE_NEEDS_SCC — kein SCC + TIA für PHI-Class Data',
      '_transcripts_ Table: keine Retention — Art. 5(1)(e) Verletzungs-Risiko',
      'Erasure unvollständig: löscht user record aber nicht embeddings table',
      'Art. 22 Trigger: LLM-Auto-Klassifikation ohne Human-in-the-Loop',
    ],
    excerpt: 'Vollständige PII-Inventur mit file:line, Data-Flow-Trace pro PII-Klasse, Schrems-II-TIA-Analyse für jeden US-bound Service (besonders US AI-Provider explizit geflaggt). Article 30 RoPA als populated draft ready für DPO-Adoption.',
  },
  {
    id: 'sample-sbom', prompt: 'SBOM', category: 'Compliance',
    title: 'CycloneDX 1.5 SBOM für Edge-IoT Container-Image',
    client: 'TidalEdge IoT GmbH (fiktiv) · 12 000 deployed devices',
    fee: '€3 400 / Release · €18 000 annual contract',
    date: '2026-05-12',
    outcomeNumber: '287', outcomeLabel: 'Components · 18 CVEs · 0 GPL contamination',
    highlights: [
      '287 Components inventarisiert (84 direct Go + 203 transitive + 47 Alpine)',
      '1 Critical CVE in golang/protobuf v1.5.3 (reachable via govulncheck)',
      'License posture clean: keine GPL/AGPL/SSPL in proprietary distribution',
      '1 abandoned dependency identified + recommended replacement path',
    ],
    excerpt: 'EU CRA + US EO 14028 conformes CycloneDX 1.5 JSON plus companion-Report mit CVE-Triage, Lizenz-Analyse und Supply-Chain-Signals. Govulncheck-call-graph zeigt welche CVEs tatsächlich reachable im binary sind vs nur present-but-unused.',
  },
  {
    id: 'sample-ai-act', prompt: 'AI-ACT', category: 'Compliance',
    title: 'EU AI Act Conformity für HR-Tech Resume-Screener',
    client: 'Aurora Talent SAS (fiktiv) · 80 EU employers customer base',
    fee: '€9 500 + €18 000 follow-on documentation',
    date: '2026-05-14',
    outcomeNumber: '78 Tage', outcomeLabel: 'bis 2. August 2026 Deadline · 11 Gaps',
    highlights: [
      'Klassifikation: HIGH-RISK unter Annex III §4(a) Employment — nicht borderline',
      '11 von Chapter III obligations gemappt mit current status',
      'Art. 14 Human Oversight: aktuell auto-rank ohne pause/review gate',
      '15–17 person-week remediation roadmap mit article-cited Deadlines',
    ],
    excerpt: 'Vollständige Klassifikation unter Art. 6 + Annex III mit Article-Level-Reasoning. 11 obligations Status (IMPLEMENTED/PARTIAL/MISSING) mit Evidence. Penalty-Exposure quantifiziert pro Art. 99(4): up to €15M / 3% global turnover. First-mover-Vorteil in einem Markt mit hohem Supply-Gap.',
  },
  {
    id: 'sample-rag-audit', prompt: 'RAG-AUDIT', category: 'AI',
    title: 'RAG-System Audit für Internal-Docs-Chatbot',
    client: 'Maple Industries (fiktiv) · 4000 employees · 600 daily users',
    fee: '€9 200 engagement · €115k/Jahr identifizierte Cost-Savings',
    date: '2026-05-15',
    outcomeNumber: '$0.024 → $0.008', outcomeLabel: 'Cost/Query · 64 % → 82 % Recall@5',
    highlights: [
      'Recall@5 64% gemessen — root cause bei retrieval, nicht LLM',
      '41% der Retrieval-Misses durch chunking-boundary-Probleme',
      'Cohere Rerank 3 testet: Recall@5 64% → 82% mit +180ms latency',
      'Query-Expansion entfernen: 50% cost reduction ohne quality drop',
    ],
    excerpt: 'Gemessen auf 47-query golden set: faithfulness 71% (target 90%), hallucination rate 14% (target <5%). Cost/Query $0.024 inflated durch 4-pass query expansion ohne ROI. Top-3-Fixes ranked by quality-lift × ease projizieren Recall@5 +20pp, hallucination -8pp, cost -66%.',
  },
];

const categories = ['Alle', 'Strategic', 'Compliance', 'AI', 'Internal'] as const;
---

<section id="samples" class="section relative">
  <div class="container-page">
    <!-- Header -->
    <div class="reveal flex items-center gap-2 text-[11px] uppercase tracking-[0.2em] text-accent-400 mb-3 font-medium">
      Sample Deliverables
    </div>
    <h2 class="reveal text-display-lg font-display tracking-tight max-w-4xl mb-6">
      Zehn redaktierte Beispiel-Reports.
      <span class="text-ink-300">Sieh was du kaufst, bevor du kaufst.</span>
    </h2>
    <p class="reveal text-lg text-ink-300 max-w-2xl leading-snug mb-10">
      Jedes Sample ist fiktiv aber strukturell realistisch — Honorare und
      Befunde spiegeln, was vergleichbare Engagements am Markt tatsächlich
      kosten und liefern.
    </p>

    <!-- Filter chips -->
    <div class="reveal flex flex-wrap gap-2 mb-8" role="tablist" aria-label="Sample-Kategorie filtern">
      {categories.map((c, i) => (
        <button
          type="button"
          class="px-4 py-2 rounded-full text-sm font-medium border transition-all duration-200 no-tap focus-visible:ring-accent-300
                 data-[active=true]:bg-accent-500 data-[active=true]:text-ink-950 data-[active=true]:border-accent-500
                 data-[active=false]:bg-white/5 data-[active=false]:text-ink-200 data-[active=false]:border-white/10
                 data-[active=false]:hover:bg-white/10 data-[active=false]:hover:border-white/20"
          data-filter={c}
          data-active={i === 0 ? 'true' : 'false'}
          role="tab"
        >
          {c}
          {i === 0 && <span class="ml-1.5 text-xs opacity-70">({samples.length})</span>}
        </button>
      ))}
    </div>

    <!-- Sample grid -->
    <div
      class="grid md:grid-cols-2 gap-5 lg:gap-6"
      data-samples-grid
    >
      {samples.map((s, i) => (
        <article
          id={s.id}
          data-sample-card
          data-category={s.category}
          class="reveal card-spotlight group relative rounded-2xl border border-white/10
                 bg-ink-900/50 backdrop-blur-xl overflow-hidden
                 transition-all duration-500 ease-out
                 hover:border-white/20 hover:-translate-y-0.5"
          style={`animation-delay: ${i * 40}ms`}
        >
          <!-- Top bar — like a document window -->
          <div class="flex items-center justify-between px-5 py-3 border-b border-white/5 bg-ink-900/70">
            <div class="flex items-center gap-2">
              <span class="font-mono text-[10px] font-medium text-accent-300 tracking-wider">{s.prompt}</span>
              <span class="text-ink-600">·</span>
              <span class="text-[10px] text-ink-400">{s.category}</span>
            </div>
            <span class="font-mono text-[10px] text-ink-500 tabular-nums">{s.date}</span>
          </div>

          <!-- Body -->
          <div class="p-6 flex flex-col gap-4">
            <!-- Title -->
            <h3 class="font-display text-lg lg:text-xl text-ink-50 leading-tight">
              {s.title}
            </h3>

            <!-- Client + fee -->
            <div class="flex flex-col gap-1 text-xs">
              <div class="flex items-center gap-1.5 text-ink-300">
                <svg class="text-ink-500" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 21V9a2 2 0 012-2h14a2 2 0 012 2v12M3 21h18M9 9V5a2 2 0 012-2h2a2 2 0 012 2v4"/>
                </svg>
                <span>{s.client}</span>
              </div>
              <div class="flex items-center gap-1.5 text-accent-300">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="12" y1="1" x2="12" y2="23"/>
                  <path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/>
                </svg>
                <span class="font-medium">{s.fee}</span>
              </div>
            </div>

            <!-- Outcome metric (if present) -->
            {s.outcomeNumber && (
              <div class="rounded-lg bg-gradient-to-br from-accent-500/10 to-transparent border border-accent-500/20 px-4 py-3">
                <div class="text-display-md font-display text-gradient leading-none tabular-nums">{s.outcomeNumber}</div>
                <div class="text-xs text-ink-300 mt-1">{s.outcomeLabel}</div>
              </div>
            )}

            <!-- Excerpt -->
            <p class="text-sm text-ink-300 leading-relaxed">
              {s.excerpt}
            </p>

            <!-- Highlights (chips) -->
            <details class="group/details">
              <summary class="cursor-pointer text-sm font-medium text-accent-300 hover:text-accent-200 transition-colors flex items-center gap-1.5 no-tap select-none focus-visible:ring-accent-300 rounded">
                Key findings ansehen
                <svg
                  class="transition-transform duration-300 group-open/details:rotate-180"
                  width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                >
                  <polyline points="6 9 12 15 18 9"/>
                </svg>
              </summary>
              <ul class="mt-3 space-y-2 text-sm text-ink-300">
                {s.highlights.map(h => (
                  <li class="flex gap-2.5 leading-snug">
                    <span class="shrink-0 mt-1.5 h-1 w-1 rounded-full bg-accent-400"></span>
                    <span class="font-mono text-[12px]">{h}</span>
                  </li>
                ))}
              </ul>
            </details>
          </div>

          <!-- Footer link -->
          <a
            href={`https://github.com/beko2210/PROMPT_only/blob/main/samples/${s.prompt.replace(/-/g, '-')}-sample.md`}
            class="block border-t border-white/5 px-5 py-3 text-xs text-ink-300 hover:text-accent-200 hover:bg-white/[0.02] transition-colors no-tap"
            rel="noopener"
          >
            <span class="inline-flex items-center gap-1.5">
              Vollständiges Sample auf GitHub
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="7" y1="17" x2="17" y2="7"/>
                <polyline points="7 7 17 7 17 17"/>
              </svg>
            </span>
          </a>
        </article>
      ))}
    </div>

    <!-- Counter / footer -->
    <div class="reveal mt-12 text-center text-sm text-ink-400">
      <span data-samples-shown>{samples.length}</span> von {samples.length} Samples ·
      <a href="https://github.com/beko2210/PROMPT_only/tree/main/samples" class="text-accent-300 hover:text-accent-200">
        alle auf GitHub ansehen
      </a>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    if (typeof window === 'undefined') return;

    const wire = () => {
      const buttons = document.querySelectorAll('[data-filter]');
      const cards = document.querySelectorAll('[data-sample-card]');
      const counter = document.querySelector('[data-samples-shown]');
      if (!buttons.length || !cards.length) return;

      const applyFilter = (filter) => {
        let shown = 0;
        cards.forEach((card) => {
          const c = card.getAttribute('data-category');
          const match = filter === 'Alle' || c === filter;
          card.style.display = match ? '' : 'none';
          if (match) shown++;
        });
        buttons.forEach((b) => {
          b.setAttribute('data-active', String(b.getAttribute('data-filter') === filter));
        });
        if (counter) counter.textContent = String(shown);
      };

      buttons.forEach((b) => {
        if (b._wired) return;
        b._wired = true;
        b.addEventListener('click', () => applyFilter(b.getAttribute('data-filter')));
      });
    };

    wire();
    document.addEventListener('astro:after-swap', wire);
  })();
</script>
