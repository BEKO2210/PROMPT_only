---
// Process — 4-stage scroll-driven timeline showing how engagements run.
// Discovery -> Proposal -> Deliver -> Handover, each mapped to the
// Tier-3 ops prompts that drive it.
//
// Desktop: horizontal flow with progress line that fills on scroll
// Mobile:  vertical timeline (line left, cards right), same fill anim
// Both:    sticky title until last card scrolled into view

interface Stage {
  n: string;
  title: string;
  duration: string;
  description: string;
  prompts: string[];  // prompts that drive this stage
  outcome: string;    // what the client gets
}

const stages: Stage[] = [
  {
    n: '01',
    title: 'Discovery',
    duration: '1–2 Stunden',
    description: 'Pre-Call-Briefing mit recherchierten Pain-Signals, Stack-Inventur und Decision-Maker-Mapping. Du gehst informiert ins Erstgespräch.',
    prompts: ['DISCOVERY'],
    outcome: 'Brief mit Quellen-Zitaten · Talk-Track · Discovery-Questions · erwartete Objections + Antworten',
  },
  {
    n: '02',
    title: 'Proposal',
    duration: '24–48 Stunden',
    description: 'Send-ready Angebot mit Situation-Complication-Resolution-Struktur, ankerpreisigem Investment-Abschnitt, AI-aware T&Cs.',
    prompts: ['PROPOSAL', 'CONTRACT-REVIEW'],
    outcome: '4–8-seitiges Angebot · Scope per Phase · Acceptance-Criteria · 3-Schritt-Approval-Pfad',
  },
  {
    n: '03',
    title: 'Deliver',
    duration: '3–20 Werktage',
    description: 'Tier-2-Deliverable wird produziert: Audit / Compliance / Performance / DD. Wöchentlicher Status-Report mit Progress + Blockers.',
    prompts: ['Tier-2 Specialism', 'STATUS-REPORT', 'SCOPE-CHANGE'],
    outcome: 'Formaler Report (PDF) · Sample-Output-Qualität · Quality-Gate verifiziert · Disclaimer signiert',
  },
  {
    n: '04',
    title: 'Handover',
    duration: 'gleicher Tag',
    description: 'Cleanes Engagement-Close: Übergabe-Doku, Final-Report, Testimonial-Anfrage, Referral-Ask, Future-Work-Hook und optional Retainer-Conversion.',
    prompts: ['CLIENT-OFFBOARDING', 'TESTIMONIAL-REQUEST', 'RETAINER'],
    outcome: 'Handover-Dokument · Testimonial-Pfad · Future-Work-Hook · 50–70 % testimonials kommen daher',
  },
];
---

<section id="prozess" class="section relative" data-process>
  <div class="container-page">
    <!-- Header -->
    <div class="reveal text-[11px] uppercase tracking-[0.2em] text-accent-400 mb-3 font-medium">
      Der Prozess
    </div>
    <h2 class="reveal text-display-lg font-display tracking-tight max-w-4xl mb-6">
      Vier Stages.
      <span class="text-gradient">Sieben Tage bis erstem Deliverable.</span>
    </h2>
    <p class="reveal text-lg text-ink-300 max-w-2xl leading-snug mb-16">
      Jede Stage wird durch dedizierte Workflows aus der Bibliothek
      gefahren. Kein ad-hoc, kein Reinventieren pro Engagement.
    </p>

    <!-- ============== DESKTOP: horizontal timeline ============== -->
    <div class="hidden lg:block relative" data-process-desktop>
      <!-- Progress line (background) -->
      <div
        class="absolute top-7 left-0 right-0 h-px bg-white/10 z-0"
        aria-hidden="true"
      ></div>
      <!-- Progress line (filled, scroll-driven) -->
      <div
        class="absolute top-7 left-0 h-px bg-gradient-to-r from-accent-400 via-accent-300 to-amber-400 origin-left z-0 scale-x-0"
        style="transform-origin: left center; width: 100%;"
        data-process-line
        aria-hidden="true"
      ></div>

      <div class="grid grid-cols-4 gap-6 relative z-10">
        {stages.map((s, i) => (
          <div
            class="reveal flex flex-col items-start"
            data-process-stage
            data-index={i}
            style={`animation-delay: ${i * 80}ms`}
          >
            <!-- Node (number circle) -->
            <div
              class="relative h-14 w-14 rounded-full flex items-center justify-center border-2 transition-all duration-500
                     border-white/15 bg-ink-900 text-ink-400
                     [&[data-active='true']]:border-accent-400 [&[data-active='true']]:bg-accent-500
                     [&[data-active='true']]:text-ink-950 [&[data-active='true']]:scale-110
                     [&[data-active='true']]:shadow-glow-accent"
              data-process-node
              data-active="false"
            >
              <span class="font-display font-bold text-lg tabular-nums">{s.n}</span>
            </div>

            <!-- Card -->
            <article class="mt-6 glass card-spotlight rounded-2xl p-5 flex flex-col gap-3 grow">
              <div class="flex items-start justify-between gap-2">
                <h3 class="font-display text-xl text-ink-50 leading-tight">
                  {s.title}
                </h3>
                <span class="shrink-0 text-[10px] uppercase tracking-wider text-ink-400 mt-1">
                  {s.duration}
                </span>
              </div>

              <p class="text-sm text-ink-300 leading-snug">
                {s.description}
              </p>

              <!-- Prompts used -->
              <div class="flex flex-wrap gap-1.5 pt-2">
                {s.prompts.map(p => (
                  <span class="font-mono text-[10px] uppercase tracking-wider px-2 py-1 rounded-md bg-accent-500/10 border border-accent-500/30 text-accent-300">
                    {p}
                  </span>
                ))}
              </div>

              <!-- Outcome -->
              <div class="mt-auto pt-3 border-t border-white/5">
                <div class="text-[10px] uppercase tracking-wider text-ink-400 mb-1">Output</div>
                <p class="text-xs text-ink-200 leading-snug">{s.outcome}</p>
              </div>
            </article>
          </div>
        ))}
      </div>
    </div>

    <!-- ============== MOBILE: vertical timeline ============== -->
    <div class="lg:hidden relative" data-process-mobile>
      <!-- Vertical line -->
      <div
        class="absolute left-7 top-0 bottom-0 w-px bg-white/10"
        aria-hidden="true"
      ></div>
      <div
        class="absolute left-7 top-0 w-px bg-gradient-to-b from-accent-400 to-accent-300 origin-top scale-y-0"
        style="height: 100%;"
        data-process-line-mobile
        aria-hidden="true"
      ></div>

      <ol class="space-y-8">
        {stages.map((s, i) => (
          <li class="reveal flex gap-5" data-process-stage-mobile data-index={i}>
            <!-- Node -->
            <div class="relative shrink-0">
              <div
                class="h-14 w-14 rounded-full flex items-center justify-center border-2 transition-all duration-500
                       border-white/15 bg-ink-900 text-ink-400
                       [&[data-active='true']]:border-accent-400 [&[data-active='true']]:bg-accent-500
                       [&[data-active='true']]:text-ink-950 [&[data-active='true']]:scale-110"
                data-process-node-mobile
                data-active="false"
              >
                <span class="font-display font-bold text-lg tabular-nums">{s.n}</span>
              </div>
            </div>

            <!-- Card -->
            <article class="grow glass rounded-2xl p-5 flex flex-col gap-3">
              <div class="flex items-baseline justify-between gap-2">
                <h3 class="font-display text-xl text-ink-50 leading-tight">{s.title}</h3>
                <span class="shrink-0 text-[10px] uppercase tracking-wider text-ink-400">{s.duration}</span>
              </div>
              <p class="text-sm text-ink-300 leading-snug">{s.description}</p>
              <div class="flex flex-wrap gap-1.5">
                {s.prompts.map(p => (
                  <span class="font-mono text-[10px] uppercase tracking-wider px-2 py-1 rounded-md bg-accent-500/10 border border-accent-500/30 text-accent-300">{p}</span>
                ))}
              </div>
              <div class="pt-3 border-t border-white/5">
                <div class="text-[10px] uppercase tracking-wider text-ink-400 mb-1">Output</div>
                <p class="text-xs text-ink-200 leading-snug">{s.outcome}</p>
              </div>
            </article>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<script>
  (async () => {
    if (typeof window === 'undefined') return;
    const root = document.querySelector('[data-process]') as HTMLElement | null;
    if (!root) return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isDesktop = window.matchMedia('(min-width: 1024px)').matches;

    const linesH = root.querySelectorAll<HTMLElement>('[data-process-line]');
    const linesV = root.querySelectorAll<HTMLElement>('[data-process-line-mobile]');
    const nodesH = root.querySelectorAll<HTMLElement>('[data-process-node]');
    const nodesV = root.querySelectorAll<HTMLElement>('[data-process-node-mobile]');

    if (reduce) {
      linesH.forEach(l => (l.style.transform = 'scaleX(1)'));
      linesV.forEach(l => (l.style.transform = 'scaleY(1)'));
      [...nodesH, ...nodesV].forEach(n => n.setAttribute('data-active', 'true'));
      return;
    }

    try {
      const { gsap } = await import('gsap');
      const { ScrollTrigger } = await import('gsap/ScrollTrigger');
      gsap.registerPlugin(ScrollTrigger);

      // Use the desktop or mobile container based on viewport
      const lines = isDesktop ? linesH : linesV;
      const nodes = isDesktop ? nodesH : nodesV;

      gsap.timeline({
        scrollTrigger: {
          trigger: root,
          start: 'top 75%',
          end: 'bottom 70%',
          scrub: 1,
          onUpdate: (self) => {
            const p = self.progress;
            // Activate nodes proportionally
            nodes.forEach((n, i) => {
              const threshold = (i + 0.4) / nodes.length;
              n.setAttribute('data-active', p >= threshold ? 'true' : 'false');
            });
          },
        },
      }).fromTo(
        lines,
        { scaleX: 0, scaleY: 0 },
        isDesktop
          ? { scaleX: 1, transformOrigin: 'left center', ease: 'none', duration: 1 }
          : { scaleY: 1, transformOrigin: 'top center', ease: 'none', duration: 1 }
      );
    } catch (e) {
      // Fallback: simple intersection-observed reveal
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          linesH.forEach(l => (l.style.transition = 'transform 2s ease-out', l.style.transform = 'scaleX(1)'));
          linesV.forEach(l => (l.style.transition = 'transform 2s ease-out', l.style.transform = 'scaleY(1)'));
          [...nodesH, ...nodesV].forEach((n, i) => setTimeout(() => n.setAttribute('data-active', 'true'), i * 300));
          io.disconnect();
        }
      }, { threshold: 0.2 });
      io.observe(root);
    }
  })();
</script>
