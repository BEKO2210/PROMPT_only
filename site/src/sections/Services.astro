  {
    id: 'dd',
    icon: 'M20 7h-4V5a3 3 0 00-3-3h-2a3 3 0 00-3 3v2H4a2 2 0 00-2 2v11a2 2 0 002 2h16a2 2 0 002-2V9a2 2 0 00-2-2zM10 5a1 1 0 011-1h2a1 1 0 011 1v2h-4V5z',
    name: 'Technical Due Diligence',
    tagline: 'R/A/G Dashboard · Deal-Term Recommendations · M&A-defensible',
