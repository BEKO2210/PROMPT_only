---
// Services — the "what I sell" grid. 9 packaged services mapped from
// the 9 highest-margin Tier-2 prompts. Designed so a CFO / CTO can
// scan the row in 10 seconds and identify the relevant engagement.
//
// Card design: icon in glow box, headline, tagline, persona + timeline
// + price line, hover reveals 'sample ansehen' chevron. card-spotlight
// cursor follower active per card.

interface Service {
  id: string;
  icon: string;         // SVG path data (single d= attribute)
  iconViewBox?: string; // default 0 0 24 24
  name: string;
  tagline: string;
  price: string;
  persona: string;
  timeline: string;
  sampleAnchor?: string; // if a sample exists, the anchor id in #samples
  accent: 'cyan' | 'amber';
}

