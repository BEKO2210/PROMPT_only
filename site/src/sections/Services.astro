const accentClass = (a: string) => a === 'amber'
  ? 'text-amber-400 bg-amber-500/10 border-amber-500/30'
  : 'text-accent-300 bg-accent-500/10 border-accent-500/30';
---

<section id="services" class="section relative">
  <div class="container-page">
    <!-- Header -->
    <div class="reveal flex items-center gap-2 text-[11px] uppercase tracking-[0.2em] text-accent-400 mb-3 font-medium">
      Services
    </div>
    <h2 class="reveal text-display-lg font-display tracking-tight max-w-4xl mb-6">
      Neun Engagement-Typen, sofort einsetzbar.
    </h2>
    <p class="reveal text-lg text-ink-300 max-w-2xl leading-snug mb-16">
      Jede Karte mapped einen Tier-2-Prompt aus der Bibliothek auf eine
      verkaufsfertige Beratungs-Leistung. Preise sind Anker-Ranges, nicht
      Schätzungen — sie spiegeln, was Märkte tatsächlich zahlen.
    </p>

    <!-- 3x3 grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 lg:gap-6">
      {services.map((s, i) => (
        <article
          class="reveal card-spotlight group relative rounded-2xl border border-white/10
                 bg-ink-900/50 backdrop-blur-xl p-6 lg:p-7 flex flex-col
                 transition-all duration-500 ease-out
                 hover:border-white/20 hover:-translate-y-1
                 hover:bg-ink-900/70 hover:shadow-glow-soft"
          style={`animation-delay: ${i * 50}ms`}
        >
          <!-- Icon + accent header -->
          <div class="flex items-start justify-between mb-5">
            <div class={`relative inline-flex h-12 w-12 items-center justify-center rounded-xl border ${accentClass(s.accent)} transition-transform duration-500 group-hover:scale-110 group-hover:rotate-[-4deg]`}>
              <svg
                width="22" height="22"
                viewBox={s.iconViewBox ?? '0 0 24 24'}
                fill="none" stroke="currentColor"
                stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={s.icon}/>
              </svg>
            </div>
            <span class="font-mono text-[10px] text-ink-500 tabular-nums">
              {String(i + 1).padStart(2, '0')} / {services.length}
            </span>
          </div>

          <!-- Title + tagline -->
          <h3 class="font-display text-lg lg:text-xl text-ink-50 leading-tight mb-2">
            {s.name}
          </h3>
          <p class="text-sm text-ink-300 leading-snug mb-5 grow">
            {s.tagline}
          </p>

          <!-- Price (anchored prominently) -->
          <div class="mb-4">
            <div class="text-[10px] uppercase tracking-[0.15em] text-ink-400 mb-1 font-medium">Investment</div>
            <div class="text-xl font-display font-semibold text-ink-50 tabular-nums">
              {s.price}
            </div>
          </div>

          <!-- Persona + timeline -->
          <div class="space-y-2 pt-4 border-t border-white/5 text-xs text-ink-400 leading-snug">
            <div class="flex items-start gap-2">
              <svg class="shrink-0 mt-0.5 text-ink-500" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="7" r="4"/>
                <path d="M5 21v-2a7 7 0 0114 0v2"/>
              </svg>
              <span>{s.persona}</span>
            </div>
            <div class="flex items-start gap-2">
              <svg class="shrink-0 mt-0.5 text-ink-500" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
              </svg>
              <span>{s.timeline}</span>
            </div>
          </div>

          <!-- Hover-revealed CTA -->
          {s.sampleAnchor && (
            <a
              href={`#${s.sampleAnchor}`}
              class="mt-5 inline-flex items-center gap-1.5 text-sm text-accent-300
                     opacity-70 group-hover:opacity-100 transition-opacity duration-300
                     hover:text-accent-200 no-tap focus-visible:ring-accent-300 rounded"
            >
              Sample ansehen
              <svg
                class="transition-transform duration-300 group-hover:translate-x-1"
                width="14" height="14" viewBox="0 0 24 24"
                fill="none" stroke="currentColor"
                stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
              >
                <line x1="5" y1="12" x2="19" y2="12"/>
                <polyline points="12 5 19 12 12 19"/>
              </svg>
            </a>
          )}
        </article>
      ))}
    </div>

    <!-- Footer: 'and 70+ more' nudge -->
    <div class="reveal mt-12 text-center">
      <p class="text-sm text-ink-400">
        Plus 69 weitere Workflows in der Bibliothek — Bundles ab €8 000.
        <a href="#preise" class="text-accent-300 hover:text-accent-200 underline-offset-4 hover:underline">
          Bundle-Optionen ansehen
        </a>
      </p>
    </div>
  </div>
</section>
