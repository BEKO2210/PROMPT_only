---
// Hero — cinematic mission-control rebuild.
// Full viewport, scan-line on first paint, mission-status-tag,
// Three.js audit-core orb (with SVG fallback), magnetic CTAs,
// framework strip on the bottom edge.
//
// Headline: user-direktive copy
//   "Senior Software Audits. Geliefert wie ein Produktfilm.
//    Verifiziert wie ein Board-Report."
// Alt copy preserved in HEADLINE_ALT for easy A/B swap.

import ThreeHeroCore from '@components/ThreeHeroCore.astro';
import FrameworkStrip from '@components/FrameworkStrip.astro';
import CinematicHeading from '@components/CinematicHeading.astro';
import MagneticButton from '@components/MagneticButton.astro';
import LiquidBg from '@components/LiquidBg.astro';

const baseUrl = import.meta.env.BASE_URL;

// Headline lines — easy to A/B swap by changing this array
const HEADLINE = [
  { text: 'Senior Software Audits.',         accent: 'plain'  as const, weight: 700 as const },
  { text: 'Geliefert wie ein Produktfilm.',  accent: 'plain'  as const, weight: 600 as const },
  { text: 'Verifiziert wie ein Board-Report.', accent: 'accent' as const, weight: 700 as const },
];

// Alt for future swap:
// const HEADLINE_ALT = [
//   { text: 'From codebase to board-ready audit', accent: 'plain'  as const, weight: 700 as const },
//   { text: 'in days, not weeks.',                accent: 'accent' as const, weight: 700 as const },
// ];

// Current date for mission tag (server-rendered; updated client-side too)
const now = new Date();
const isoDate = now.toISOString().slice(0, 10);
---

<section
  id="hero"
  class="surface-vacuum mission-grid relative min-h-[100svh] flex items-center pt-28 pb-section-sm overflow-hidden"
  aria-labelledby="hero-headline"
>
  <!-- Liquid WebGL background — domain-warped noise shader, reacts to
       cursor + scroll. Hidden until mount; CSS gradient + grid show
       behind on no-WebGL / reduced-motion. -->
  <LiquidBg z={-10} tone="cyan" />

  <!-- Decorative vacuum + ambient glow (fallback layer; sits between
       liquid shader and content) -->
  <div class="pointer-events-none absolute inset-0 -z-[9]" aria-hidden="true">
    <div
      class="absolute top-[5%] left-[12%] h-[520px] w-[520px] rounded-full bg-accent-500/10 blur-[140px] animate-float"
      style="animation-duration: 14s"
    ></div>
    <div
      class="absolute bottom-[5%] right-[10%] h-[460px] w-[460px] rounded-full bg-accent-400/6 blur-[140px] animate-float"
      style="animation-duration: 18s; animation-delay: -4s"
    ></div>
    <svg class="absolute inset-0 w-full h-full opacity-[0.03] mix-blend-overlay" aria-hidden="true">
      <filter id="noiseFilter"><feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2" stitchTiles="stitch"/></filter>
      <rect width="100%" height="100%" filter="url(#noiseFilter)"/>
    </svg>
  </div>

  <!-- Scanline on first paint -->
  <div class="hero-scanline" aria-hidden="true"></div>

  <!-- Top mission-status tag — desktop only; on mobile this would
       collide with the nav + eyebrow. Bottom-positioned so the Nav has
       its own clean lane above. -->
  <div
    data-hero-anim="0"
    class="opacity-0 absolute bottom-6 left-6 lg:left-12 z-10 hidden md:flex flex-col gap-1.5 pointer-events-none"
  >
    <span class="mission-tag">
      <span data-mission-status>LIVE · DE · {isoDate}</span>
    </span>
  </div>

  <!-- Brand corner stamp — desktop large only (lg+); below nav with
       comfortable clearance so it never overlaps the Nav CTA -->
  <div
    data-hero-anim="0"
    class="opacity-0 absolute bottom-6 right-6 lg:right-12 z-10 hidden lg:flex items-center gap-3 pointer-events-none"
  >
    <div class="text-right font-mono text-[10px] uppercase tracking-[0.18em] leading-snug">
      <div class="text-accent-300">78 / 9 / 10</div>
      <div class="text-ink-500">Workflows · Services · Samples</div>
    </div>
  </div>

  <div class="container-page w-full">
    <div class="grid lg:grid-cols-12 gap-14 items-center">
      <!-- LEFT: copy + CTAs -->
      <div class="lg:col-span-7 order-2 lg:order-1">
        <!-- Eyebrow badge -->
        <div
          data-hero-anim="0"
          class="opacity-0 inline-flex items-center gap-2 rounded-full
                 border border-accent-500/25 bg-accent-500/8 backdrop-blur-md
                 px-3.5 py-1.5 text-[12px] text-accent-200 mb-7 font-mono tracking-[0.1em] uppercase"
        >
          <span class="relative flex h-1.5 w-1.5">
            <span class="absolute inset-0 rounded-full bg-accent-400 animate-ping opacity-75"></span>
            <span class="relative h-1.5 w-1.5 rounded-full bg-accent-400"></span>
          </span>
          78 Workflows · 10 Samples · Production-Grade
        </div>

        <!-- Cinematic headline — text-display-xl (max 80px) keeps three
             lines on-page at lg without wrapping to 6+ rows -->
        <CinematicHeading
          as="h1"
          id="hero-headline"
          lines={HEADLINE}
          size="text-display-xl"
          class="mb-7"
        />

        <!-- Subhead -->
        <p
          data-hero-anim="4"
          class="opacity-0 max-w-prose-tight text-lg lg:text-xl text-ink-200 leading-snug mb-9"
        >
          Eine kuratierte Bibliothek aus <strong class="text-ink-50 font-medium">78 production-grade Workflows</strong>
          produziert Audit-, Compliance-, Architecture- und Due-Diligence-Reports
          auf Beratungsklasse-Niveau. Lieferzeit
          <strong class="text-accent-300 font-medium">60–80 % kürzer</strong>,
          ohne Qualitätsverlust.
        </p>

        <!-- CTA pair -->
        <div data-hero-anim="5" class="opacity-0 flex flex-wrap gap-3 mb-10">
          <MagneticButton href={`${baseUrl}kontakt`} tone="primary" strength={0.4}>
            Erstgespräch buchen
          </MagneticButton>
          <MagneticButton href={`${baseUrl}samples`} tone="secondary" strength={0.3}>
            Sample-Reports ansehen
          </MagneticButton>
        </div>

        <!-- Trust line -->
        <div data-hero-anim="6" class="opacity-0 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm text-ink-300">
          <div class="flex items-center gap-2">
            <svg class="text-success" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            Verbatim-Disclaimer · haftungsbewusst formuliert
          </div>
          <div class="flex items-center gap-2">
            <svg class="text-success" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            Sample-Outputs vor Vertragsabschluss
          </div>
        </div>
      </div>

      <!-- RIGHT: WebGL audit-core orb -->
      <div class="lg:col-span-5 order-1 lg:order-2 relative">
        <div data-hero-anim="3" class="opacity-0 relative">
          <ThreeHeroCore size={520} />
        </div>
      </div>
    </div>
  </div>

  <!-- Framework strip — bottom edge -->
  <div
    data-hero-anim="6"
    class="opacity-0 absolute bottom-16 left-0 right-0 z-10"
  >
    <FrameworkStrip tone="subtle" />
  </div>

  <!-- Scroll cue -->
  <a
    href={`${baseUrl}methodik`}
    class="absolute bottom-4 left-1/2 -translate-x-1/2 z-10
           flex flex-col items-center gap-2 text-ink-400
           hover:text-ink-100 transition-colors no-tap group"
    aria-label="Weiter zur Methodik"
    data-hero-anim="6"
    style="opacity:0"
  >
    <span class="text-[10px] uppercase tracking-[0.2em] font-mono">Methodik</span>
    <span class="inline-flex h-9 w-6 items-center justify-center rounded-full border border-ink-500/40 overflow-hidden">
      <span class="block h-2 w-1 rounded-full bg-accent-300 animate-bounce" style="animation-duration: 1.5s"></span>
    </span>
  </a>
</section>

<script>
  // Hero entrance — stagger reveal of all [data-hero-anim] elements.
  // Mission-status-tag clock auto-updates every 60 s.
  //
  // CRITICAL: Astro's ClientRouter does NOT re-execute scripts on
  // view-transition swap. So we register an astro:after-swap listener
  // at module load that re-runs the entrance whenever we land back on
  // a page containing a Hero. Without this, navigating Logo → Home
  // (or any other → Home via ClientRouter) leaves [data-hero-anim]
  // elements stuck at opacity:0 — the hero appears completely blank.

  const HERO_CLOCK_INTERVAL_KEY = '__heroClock';

  const runHeroEntrance = async () => {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const els = Array.from(document.querySelectorAll<HTMLElement>('[data-hero-anim]'))
      .sort((a, b) => Number(a.dataset.heroAnim) - Number(b.dataset.heroAnim));

    if (!els.length) return;

    if (reduce) {
      els.forEach((el) => (el.style.opacity = '1'));
    } else {
      try {
        const { gsap } = await import('gsap');
        gsap.fromTo(
          els,
          { opacity: 0, y: 32, filter: 'blur(8px)' },
          {
            opacity: 1,
            y: 0,
            filter: 'blur(0px)',
            duration: 1.0,
            ease: 'expo.out',
            stagger: 0.09,
            clearProps: 'filter,transform',
          }
        );
      } catch {
        els.forEach((el, i) => {
          el.style.transition = `opacity 600ms ease-out ${i * 80}ms, transform 600ms ease-out ${i * 80}ms`;
          el.style.opacity = '1';
        });
      }
    }

    // Hard safety: in case GSAP import hangs, force visible at 1.5s
    setTimeout(() => {
      els.forEach((el) => {
        if (getComputedStyle(el).opacity === '0') el.style.opacity = '1';
      });
    }, 1500);

    // Live mission clock — single interval per page session.
    const tag = document.querySelector<HTMLElement>('[data-mission-status]');
    if (tag) {
      const update = () => {
        const d = new Date();
        const iso = d.toISOString().slice(0, 10);
        const hh = String(d.getUTCHours()).padStart(2, '0');
        const mm = String(d.getUTCMinutes()).padStart(2, '0');
        tag.textContent = `LIVE · DE · ${iso} · ${hh}:${mm} UTC`;
      };
      update();
      const w = window as unknown as Record<string, number | undefined>;
      if (w[HERO_CLOCK_INTERVAL_KEY]) clearInterval(w[HERO_CLOCK_INTERVAL_KEY]);
      w[HERO_CLOCK_INTERVAL_KEY] = setInterval(update, 60_000) as unknown as number;
    }
  };

  // Initial paint
  runHeroEntrance();

  // Every ClientRouter view-transition swap — re-run if the swapped-in
  // page contains a Hero. Pure additive: no risk on pages without one.
  document.addEventListener('astro:after-swap', runHeroEntrance);
</script>
